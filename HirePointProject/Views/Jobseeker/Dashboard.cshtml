@{
    ViewData["Title"] = "Jobseeker Dashboard";

    var recommendedJobs =
        ViewBag.RecommendedJobs as List<HirePoint.Models.Job>;
}

<style>

    /* ==========================
           DASHBOARD PAGE
           ========================== */

    .jobseeker-page {
        background: #ffffff;
        padding: 25px;
        border-radius: 14px;
        min-height: calc(100vh - 120px);
    }

    /* ==========================
           HEADER
           ========================== */

    .jobseeker-header {
        margin-bottom: 25px;
    }

        .jobseeker-header h2 {
            color: #183b56;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .jobseeker-header p {
            color: #66737d;
            margin-bottom: 0;
        }

    /* ==========================
           ALERTS
           ========================== */

    .jobseeker-alert {
        border-radius: 10px;
        margin-bottom: 20px;
    }

    /* ==========================
           STAT CARDS
           ========================== */

    .jobseeker-card {
        background: #FBFFD9;
        border: 1px solid #FBFFD9;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.07);
        transition: all 0.2s ease;
    }

        .jobseeker-card:hover {
            transform: translateY(-3px);
            border-color: #E4FF00;
            box-shadow: 0 6px 16px rgba(40, 120, 173, 0.16);
        }

    .jobseeker-card-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef6fb;
        color: #333615;
        border-radius: 9px;
        font-size: 20px;
        margin-bottom: 12px;
    }

    .jobseeker-card h5 {
        color: #183b56;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .jobseeker-card h2 {
        color: #2878ad;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .jobseeker-card p {
        color: #66737d;
        font-size: 14px;
        margin-bottom: 15px;
    }

    /* ==========================
           BUTTONS
           ========================== */

    .jobseeker-btn,
    .jobseeker-apply-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #2878ad;
        color: #ffffff;
        border: 1px solid #2878ad;
        border-radius: 7px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .jobseeker-btn:hover,
        .jobseeker-apply-btn:hover {
            background: #1f628e;
            border-color: #1f628e;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(40, 120, 173, 0.25);
        }

    /* ==========================
           RECOMMENDED JOBS SECTION
           ========================== */

    .jobseeker-section {
        background: #ffffff;
        border: 1px solid #d7e7f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.07);
    }

    .jobseeker-section-header {
        background: #2878ad;
        color: #ffffff;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .jobseeker-section-header h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .jobseeker-section-header a {
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

            .jobseeker-section-header a:hover {
                opacity: 0.8;
            }

        /* ==========================
           UPDATE INTERESTS LINK
           ========================== */

        .jobseeker-section-header .update-interests-link {
            color: #ffffff;
            text-decoration: none;
            padding: 8px 12px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .jobseeker-section-header .update-interests-link:hover {
                background: #FBFFD9;
                color: #183b56;
                font-weight: 600;
                opacity: 1;
            }

    /* ==========================
           RESTART TOUR BUTTON
           ========================== */

    .restart-tour-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-left: 8px;
        padding: 8px 12px;
        border-radius: 8px;
        color: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .restart-tour-link:hover {
            background: #FBFFD9;
            color: #183b56;
        }

    /* ==========================
           TABLE
           ========================== */

    .jobseeker-table {
        margin-bottom: 0;
    }

        .jobseeker-table thead th {
            background: #f3f8fb;
            color: #183b56;
            border-bottom: 1px solid #d7e7f0;
            padding: 12px 14px;
            font-size: 13px;
            font-weight: 600;
        }

        .jobseeker-table tbody td {
            padding: 12px 14px;
            color: #3d4f5c;
            font-size: 13px;
            border-color: #e5eef3;
            vertical-align: middle;
        }

        .jobseeker-table tbody tr:hover {
            background: #eef6fb;
        }

    /* ==========================
           JOB TITLE
           ========================== */

    .job-title {
        color: #183b56;
        font-weight: 600;
    }

    /* ==========================
           COMPANY
           ========================== */

    .company-name {
        color: #183b56;
        font-weight: 600;
    }

    /* ==========================
           RECOMMENDED JOB CARDS
           ========================== */

    .job-cards-container {
        display: flex;
        flex-direction: column;
        gap: 18px;
        width: 100%;
        padding: 24px;
        background: #ffffff;
        box-sizing: border-box;
    }

    /* ==========================
           INDIVIDUAL JOB CARD
           ========================== */

    .recommended-job-card {
        width: 100%;
        background: #DBFFFD;
        border: 1px solid #d7e7f0;
        border-radius: 16px;
        padding: 25px;
        box-sizing: border-box;
        box-shadow: 0 4px 12px rgba(24, 59, 86, 0.06);
        transition: all 0.2s ease;
    }

        .recommended-job-card:hover {
            border-color: #2878ad;
            box-shadow: 0 8px 20px rgba(40, 120, 173, 0.14);
            transform: translateY(-3px);
        }

    /* ==========================
           JOB TITLE
           ========================== */

    .recommended-job-title {
        margin: 0 0 20px 0;
        color: #183b56;
        font-size: 23px;
        font-weight: 700;
        line-height: 1.3;
    }

    /* ==========================
           JOB DETAILS
           ========================== */

    .recommended-job-detail {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #3d4f5c;
        font-size: 15px;
    }

    .recommended-job-details {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        padding: 16px 0;
        border-top: 1px solid #edf3f7;
        border-bottom: 1px solid #edf3f7;
    }

    .recommended-job-detail i {
        color: #2878ad;
        font-size: 18px;
    }

    .detail-label {
        color: #183b56;
        font-weight: 700;
    }

    .detail-value {
        color: #4f606c;
        font-weight: 500;
    }

    /* ==========================
           JOB DESCRIPTION
           ========================== */

    .recommended-job-description {
        margin-top: 18px;
        color: #66737d;
        font-size: 15px;
        line-height: 1.7;
    }

    /* ==========================
           CARD FOOTER
           ========================== */

    .recommended-job-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: 20px;
    }

    /* ==========================
           VIEW JOB BUTTON
           ========================== */

    .view-job-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #2878ad;
        color: #ffffff;
        border: none;
        border-radius: 9px;
        padding: 10px 19px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .view-job-btn:hover {
            background: #1f628e;
            border-color: #1f628e;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(40, 120, 173, 0.2);
        }

    /* ==========================
           EMPTY STATE
           ========================== */

    .jobseeker-empty {
        color: #71808a;
        text-align: center;
        padding: 30px !important;
    }

    /* ==========================
           INTERESTS NOTICE
           ========================== */

    .interest-notice {
        padding: 20px;
        background: #f8fbfd;
        text-align: center;
    }

    .interest-notice-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef6fb;
        color: #2878ad;
        border-radius: 50%;
        font-size: 21px;
    }

    .interest-notice h6 {
        color: #183b56;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .interest-notice p {
        color: #66737d;
        font-size: 13px;
        margin-bottom: 15px;
    }

    /* ==========================
           RESPONSIVE
           ========================== */

    @@media (max-width: 768px) {

        .jobseeker-page {
            padding: 15px;
        }

        .jobseeker-header h2 {
            font-size: 22px;
        }

        .jobseeker-card {
            padding: 16px;
        }

        .jobseeker-section-header {
            padding: 12px 14px;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .jobseeker-table {
            min-width: 850px;
        }

        .job-cards-container {
            padding: 15px;
            gap: 15px;
        }

        .recommended-job-card {
            padding: 18px;
        }

        .recommended-job-title {
            font-size: 18px;
        }

        .recommended-job-details {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .recommended-job-footer {
            justify-content: flex-start;
        }

        .restart-tour-link {
            margin-left: 0;
        }
    }

</style>


<div class="jobseeker-page">

    <!-- ==========================
         PAGE HEADER
         ========================== -->

    <div class="jobseeker-header"
         id="dashboardHeader">

        <h2>
            <i class="bi bi-speedometer2 me-2"></i>
            Dashboard
        </h2>

        <p>
            Welcome back,
            <strong>@ViewBag.UserName</strong>.
            Find opportunities, manage your applications,
            and keep your profile up to date.
        </p>

    </div>


    <!-- ==========================
         SUCCESS MESSAGE
         ========================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show jobseeker-alert"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ==========================
         ERROR MESSAGE
         ========================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show jobseeker-alert"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ==========================
         STATISTICS
         ========================== -->

    <div class="row g-4 mb-4"
         id="dashboardStats">

        <!-- AVAILABLE JOBS -->

        <div class="col-lg-4 col-md-6">

            <div class="jobseeker-card">

                <div class="jobseeker-card-icon">
                    <i class="bi bi-briefcase"></i>
                </div>

                <h5>
                    Available Jobs
                </h5>

                <h2>
                    @ViewBag.AvailableJobs
                </h2>

            </div>

        </div>


        <!-- APPLICATIONS -->

        <div class="col-lg-4 col-md-6">

            <div class="jobseeker-card">

                <div class="jobseeker-card-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <h5>
                    My Applications
                </h5>

                <h2>
                    @ViewBag.Applications
                </h2>

            </div>

        </div>


        <!-- NOTIFICATIONS -->

        <div class="col-lg-4 col-md-6">

            <div class="jobseeker-card">

                <div class="jobseeker-card-icon">
                    <i class="bi bi-bell"></i>
                </div>

                <h5>
                    My Notifications
                </h5>

                <h2>
                    @ViewBag.UnreadNotifications
                </h2>

            </div>

        </div>

    </div>


    <!-- ==========================
         RECOMMENDED JOBS
         ========================== -->

    <div class="jobseeker-section"
         id="recommendedJobs">

        <div class="jobseeker-section-header">

            <h5>
                <i class="bi bi-stars me-2"></i>
                Jobs Recommended For You
            </h5>

            <div>

                <!-- UPDATE INTERESTS -->

                <a asp-controller="Jobseeker"
                   asp-action="Interests"
                   class="update-interests-link"
                   id="updateInterestsLink">

                    <i class="bi bi-heart me-1"></i>
                    Update Interests

                </a>


                <!-- RESTART FULL TOUR -->

                <a href="javascript:void(0);"
                   id="restartJobseekerTour"
                   class="restart-tour-link">

                    <i class="bi bi-play-circle"></i>
                    Restart Full Tour

                </a>

            </div>

        </div>


        @if (ViewBag.HasInterests != null &&
             ViewBag.HasInterests == true &&
             recommendedJobs != null &&
             recommendedJobs.Any())
        {
            <div class="job-cards-container"
                 id="recommendedJobCards">

                @foreach (var job in recommendedJobs)
                {
                    <div class="recommended-job-card">

                        <!-- JOB TITLE -->

                        <h3 class="recommended-job-title">
                            @job.JobTitle
                        </h3>


                        <!-- JOB DETAILS -->

                        <div class="recommended-job-details">

                            <!-- SALARY -->

                            <div class="recommended-job-detail">

                                <i class="bi bi-cash-stack"></i>

                                <span class="detail-label">
                                    Salary:
                                </span>

                                <span class="detail-value">
                                    @job.Salary
                                </span>

                            </div>


                            <!-- EMPLOYMENT TYPE -->

                            <div class="recommended-job-detail">

                                <i class="bi bi-briefcase"></i>

                                <span class="detail-label">
                                    Employment:
                                </span>

                                <span class="detail-value">
                                    @job.EmploymentType
                                </span>

                            </div>


                            <!-- COMPANY -->

                            <div class="recommended-job-detail">

                                <i class="bi bi-building"></i>

                                <span class="detail-label">
                                    Company:
                                </span>

                                <span class="detail-value">

                                    @if (job.Recruiter?.RecruiterProfile != null &&
                                         !string.IsNullOrWhiteSpace(
                                             job.Recruiter.RecruiterProfile.CompanyName))
                                    {
                                        @job.Recruiter.RecruiterProfile.CompanyName
                                    }
                                    else
                                    {
                                        <span>
                                            Company not provided
                                        </span>
                                    }

                                </span>

                            </div>


                            <!-- LOCATION -->

                            <div class="recommended-job-detail">

                                <i class="bi bi-geo-alt"></i>

                                <span class="detail-label">
                                    Location:
                                </span>

                                <span class="detail-value">
                                    @job.City, @job.Province
                                </span>

                            </div>

                        </div>


                        <!-- JOB DESCRIPTION -->

                        <div class="recommended-job-description">

                            @if (!string.IsNullOrWhiteSpace(job.JobDescription))
                            {
                                if (job.JobDescription.Length > 180)
                                {
                                    @job.JobDescription.Substring(0, 180)
                                    <span>...</span>
                                }
                                else
                                {
                                    @job.JobDescription
                                }
                            }
                            else
                            {
                                <span>
                                    No job description provided.
                                </span>
                            }

                        </div>


                        <!-- VIEW JOB BUTTON -->

                        <div class="recommended-job-footer">

                            <a asp-controller="Jobseeker"
                               asp-action="JobDetails"
                               asp-route-id="@job.JobID"
                               class="view-job-btn">

                                View Job

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else if (ViewBag.HasInterests != null &&
                 ViewBag.HasInterests == true)
        {
            <div class="jobseeker-empty">

                <i class="bi bi-search fs-4 d-block mb-2"></i>

                No matching jobs are available right now.

            </div>
        }
        else
        {
            <div class="interest-notice">

                <div class="interest-notice-icon">
                    <i class="bi bi-heart-fill"></i>
                </div>

                <h6>
                    Tell us what jobs you're interested in
                </h6>

                <p>
                    Select your job interests and HirePoint will
                    recommend suitable opportunities directly on
                    your dashboard.
                </p>

                <a asp-controller="Jobseeker"
                   asp-action="Interests"
                   class="jobseeker-btn">

                    <i class="bi bi-heart me-1"></i>
                    Select Job Interests

                </a>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const restartButton =
                document.getElementById("restartJobseekerTour");

            if (!restartButton) {
                return;
            }

            restartButton.addEventListener("click", function () {

                if (window.HirePointTour) {

                    window.HirePointTour.restart();

                } else {

                    console.error(
                        "HirePointTour was not loaded. Make sure ~/js/hirepoint-tour.js is included in _Layout.cshtml."
                    );

                }

            });

        });

    </script>

}
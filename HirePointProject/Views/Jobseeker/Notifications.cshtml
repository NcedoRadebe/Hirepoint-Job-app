@model IEnumerable<HirePoint.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<style>

    /* =========================
               NOTIFICATIONS PAGE
               ========================= */

    .notifications-page {
        background: var(--jobseeker-bg, #f5f7f6);
        min-height: 100vh;
        padding: 25px 0 40px;
    }


    /* =========================
               HEADER
               ========================= */

    .notifications-header {
        background: var(--jobseeker-primary, #2878ad);
        color: #fff;
        border-radius: 14px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
        transition: .25s ease;
    }

        .notifications-header:hover {
            background: var(--jobseeker-primary-hover, #2878ad);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,.12);
        }

        .notifications-header h2 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .notifications-header p {
            margin: 0;
            opacity: .9;
        }


    /* =========================
               DASHBOARD BUTTON
               ========================= */

    .notifications-dashboard-btn {
        color: #fff;
        border: 1px solid rgba(255,255,255,.7);
        background: transparent;
        padding: 9px 17px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: .25s ease;
    }

        .notifications-dashboard-btn:hover {
            background: #fff;
            color: var(--jobseeker-primary, #2878ad);
            border-color: #fff;
            transform: translateY(-2px);
        }


    /* =========================
               MAIN NOTIFICATIONS CARD
               ========================= */

    .notifications-card {
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,.07);
        transition: .25s ease;
    }

        .notifications-card:hover {
            box-shadow: 0 8px 22px rgba(0,0,0,.10);
        }


    /* =========================
               NOTIFICATION ITEM
               ========================= */

    .notification-item {
        display: block;
        padding: 22px 25px;
        border-bottom: 1px solid #e9ecef;
        background: #fff;
        text-decoration: none;
        color: inherit;
        transition: .25s ease;
        cursor: pointer;
    }

        .notification-item:last-child {
            border-bottom: none;
        }

        .notification-item:hover {
            background: var(--jobseeker-hover-bg, #eef5f2);
            transform: translateX(4px);
            box-shadow: inset 4px 0 0 var(--jobseeker-primary, #2878ad);
            text-decoration: none;
            color: inherit;
        }


    /* =========================
               UNREAD NOTIFICATION
               ========================= */

    .notification-unread {
        background: #eaf5fc;
        box-shadow: inset 4px 0 0 #2878ad;
    }

        .notification-unread:hover {
            background: #e0f0fa;
        }


    /* =========================
               ICON
               ========================= */

    .notification-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s ease;
    }

    .notification-item:hover .notification-icon {
        transform: scale(1.08);
    }


    .notification-icon-default {
        background: #eef5f2;
        color: #2878ad;
    }


    .notification-icon-success {
        background: #e8f4ed;
        color: #2878ad;
    }


    .notification-icon-danger {
        background: #fbeaea;
        color: #c0392b;
    }


    .notification-icon-interview {
        background: #eef5f2;
        color: #2878ad;
    }


    /* =========================
               TITLE
               ========================= */

    .notification-title {
        font-weight: 700;
        color: #212529;
        margin-bottom: 5px;
        transition: .2s ease;
    }

    .notification-item:hover .notification-title {
        color: var(--jobseeker-primary, #2878ad);
    }


    /* =========================
               MESSAGE
               ========================= */

    .notification-message {
        color: #6c757d;
        margin-bottom: 0;
        line-height: 1.6;
    }


    /* =========================
               UNREAD TEXT
               ========================= */

    .notification-unread .notification-title {
        color: #183b56;
    }

    .notification-unread .notification-message {
        color: #495057;
    }


    /* =========================
               DATE
               ========================= */

    .notification-date {
        color: #8a9290;
        font-size: 13px;
        white-space: nowrap;
    }


    /* =========================
               EMPTY STATE
               ========================= */

    .notifications-empty {
        background: #fff;
        border-radius: 14px;
        padding: 65px 25px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,.07);
        transition: .25s ease;
    }

        .notifications-empty:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0,0,0,.10);
        }


    .notifications-empty-icon {
        width: 85px;
        height: 85px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eef5f2;
        color: #2878ad;
        font-size: 35px;
        margin-bottom: 20px;
        transition: .25s ease;
    }

    .notifications-empty:hover .notifications-empty-icon {
        background: #2878ad;
        color: #fff;
        transform: scale(1.08);
    }


    /* =========================
               MAIN BUTTON
               ========================= */

    .notifications-btn {
        background: var(--jobseeker-primary, #2878ad);
        border: 1px solid var(--jobseeker-primary, #2878ad);
        color: #fff;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: .25s ease;
    }

        .notifications-btn:hover {
            background: var(--jobseeker-primary-hover, #2878ad);
            border-color: var(--jobseeker-primary-hover, #2878ad);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(0,0,0,.12);
        }


    /* =========================
               MOBILE
               ========================= */

    @@media (max-width: 767px) {

        .notifications-page {
            padding: 15px 0 30px;
        }

        .notifications-header {
            padding: 22px;
        }

        .notifications-dashboard-btn {
            margin-top: 15px;
        }

        .notification-item {
            padding: 18px;
        }

        .notification-date {
            margin-top: 8px;
        }
    }

</style>


<div class="notifications-page">

    <div class="container-fluid">

        <!-- =========================
             MAIN HEADER
             ========================= -->

        <div class="notifications-header">

            <div class="d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center">

                <div>

                    <h2>
                        <i class="bi bi-bell-fill me-2"></i>
                        Notifications
                    </h2>

                    <p>
                        Stay updated on your applications and interviews.
                    </p>

                </div>


                <a asp-controller="Jobseeker"
                   asp-action="Dashboard"
                   class="notifications-dashboard-btn"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   title="Return to your Jobseeker Dashboard.">

                    <i class="bi bi-arrow-left me-2"></i>

                    Dashboard

                </a>

            </div>

        </div>


        @if (!Model.Any())
        {

            <!-- =========================
                 EMPTY STATE
                 ========================= -->

            <div class="notifications-empty">

                <div class="notifications-empty-icon">

                    <i class="bi bi-bell-slash"></i>

                </div>

                <h4 class="fw-bold">
                    No notifications
                </h4>

                <p class="text-muted mb-4">

                    You don't have any notifications yet.
                    Updates about your applications will appear here.

                </p>

                <a asp-controller="Jobseeker"
                   asp-action="Applications"
                   class="notifications-btn"
                   data-bs-toggle="tooltip"
                   data-bs-placement="top"
                   title="View and track your job applications.">

                    <i class="bi bi-file-earmark-text me-2"></i>

                    View My Applications

                </a>

            </div>

        }
        else
        {

            <!-- =========================
                 NOTIFICATION LIST
                 ========================= -->

            <div class="notifications-card">

                @foreach (var notification in Model)
                {

                    string icon = "bi-bell-fill";

                    string iconClass =
                        "notification-icon-default";


                    if (notification.Title != null &&
                        notification.Title.Contains(
                            "Accepted",
                            StringComparison.OrdinalIgnoreCase))
                    {
                        icon = "bi-check-circle-fill";

                        iconClass =
                            "notification-icon-success";
                    }

                    else if (notification.Title != null &&
                             notification.Title.Contains(
                                 "Rejected",
                                 StringComparison.OrdinalIgnoreCase))
                    {
                        icon = "bi-x-circle-fill";

                        iconClass =
                            "notification-icon-danger";
                    }

                    else if (notification.Title != null &&
                             notification.Title.Contains(
                                 "Interview",
                                 StringComparison.OrdinalIgnoreCase))
                    {
                        icon =
                            "bi-calendar-check-fill";

                        iconClass =
                            "notification-icon-interview";
                    }


                    <!-- =========================
                         CLICKABLE NOTIFICATION
                         ========================= -->

                    <a asp-controller="Jobseeker"
                       asp-action="NotificationDetails"
                       asp-route-id="@notification.NotificationID"
                       class="notification-item
                        @(notification.IsRead
                           ? ""
                           : "notification-unread")"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="Open this notification to view its details.">

                        <div class="d-flex align-items-start">

                            <!-- ICON -->

                            <div class="notification-icon
                                @iconClass
                                me-3">

                                <i class="bi @icon"></i>

                            </div>


                            <!-- CONTENT -->

                            <div class="flex-grow-1">

                                <div class="d-flex
                                    flex-column
                                    flex-md-row
                                    justify-content-between">

                                    <div class="pe-md-4">

                                        <!-- TITLE -->

                                        <h6 class="notification-title">

                                            @notification.Title

                                        </h6>


                                        <!-- MESSAGE -->

                                        <p class="notification-message">

                                            @notification.Message

                                        </p>

                                    </div>


                                    <!-- DATE -->

                                    <div class="notification-date">

                                        <i class="bi bi-clock me-1"></i>

                                        @notification.DateCreated.ToString(
                                            "dd MMM yyyy, HH:mm")

                                    </div>

                                </div>

                            </div>

                        </div>

                    </a>

                }

            </div>

        }

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const tooltipTriggerList =
            document.querySelectorAll('[data-bs-toggle="tooltip"]');

        tooltipTriggerList.forEach(function (tooltipTriggerEl) {

            new bootstrap.Tooltip(tooltipTriggerEl);

        });

    });

</script>
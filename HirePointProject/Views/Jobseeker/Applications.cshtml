@model IEnumerable<HirePoint.Models.JobApplication>

@{
    ViewData["Title"] = "My Applications";
}

<style>

    /* ==========================
               PAGE
               ========================== */

    .applications-page {
        background: #eef6fb;
        padding: 25px;
        border-radius: 14px;
        min-height: 100%;
    }


    /* ==========================
               HEADER
               ========================== */

    .applications-header {
        margin-bottom: 22px;
    }

        .applications-header h2 {
            color: #183b56;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .applications-header p {
            color: #66737d;
            margin-bottom: 0;
            font-size: 14px;
        }


    /* ==========================
               MAIN CARD
               ========================== */

    .applications-card {
        background: #ffffff;
        border: 1px solid #d7e7f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.07);
    }


    /* ==========================
               CARD HEADER
               ========================== */

    .applications-card-header {
        background: #2878ad;
        color: #ffffff;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

        .applications-card-header h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }


    /* ==========================
               FIND JOBS BUTTON
               ========================== */

    .find-jobs-btn {
        background: #ffffff;
        color: #2878ad;
        border: 1px solid #ffffff;
        border-radius: 7px;
        padding: 7px 13px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .find-jobs-btn:hover {
            background: #183b56;
            border-color: #183b56;
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* ==========================
               TABLE
               ========================== */

    .applications-table {
        margin-bottom: 0;
    }

        .applications-table thead {
            background: #2878ad;
        }

            .applications-table thead th {
                background: #2878ad;
                color: #ffffff;
                border: none;
                padding: 12px 16px;
                font-size: 13px;
                font-weight: 600;
            }

        .applications-table tbody td {
            padding: 14px 16px;
            color: #3d4f5c;
            font-size: 13px;
            vertical-align: middle;
            border-color: #e5eef3;
        }

        .applications-table tbody tr {
            transition: all 0.2s ease;
        }

            .applications-table tbody tr:hover {
                background: #eef6fb;
            }


    /* ==========================
               JOB TITLE
               ========================== */

    .application-job-title {
        color: #183b56;
        font-weight: 600;
    }

        .application-job-title i {
            color: #2878ad;
        }


    /* ==========================
               DATE
               ========================== */

    .application-date {
        color: #66737d;
    }

        .application-date i {
            color: #2878ad;
        }


    /* ==========================
               STATUS
               ========================== */

    .application-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 85px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: capitalize;
    }


    /* Pending */

    .status-pending {
        background: #eef6fb;
        color: #2878ad;
        border: 1px solid #bcd8e8;
    }


    /* Accepted */

    .status-accepted {
        background: #e8f6ef;
        color: #218838;
        border: 1px solid #b8dfc8;
    }


    /* Rejected */

    .status-rejected {
        background: #fcebec;
        color: #c0392b;
        border: 1px solid #efc1c1;
    }


    /* ==========================
               EMPTY STATE
               ========================== */

    .applications-empty {
        text-align: center;
        padding: 45px 20px !important;
        color: #71808a;
    }

        .applications-empty i {
            display: block;
            font-size: 38px;
            color: #2878ad;
            margin-bottom: 12px;
        }

        .applications-empty strong {
            display: block;
            color: #183b56;
            font-size: 15px;
            margin-bottom: 5px;
        }

        .applications-empty span {
            display: block;
            font-size: 13px;
        }


    /* ==========================
               RESPONSIVE
               ========================== */

    @@media (max-width: 768px) {

        .applications-page {
            padding: 15px;
        }

        .applications-card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .find-jobs-btn {
            width: 100%;
            text-align: center;
        }

        .applications-table {
            min-width: 600px;
        }
    }

</style>


<div class="applications-page">


    <!-- ==========================
         PAGE HEADER
         ========================== -->

    <div class="applications-header">

        <h2>
            <i class="bi bi-file-earmark-text me-2"></i>
            My Applications
        </h2>

        <p>
            Track the jobs you have applied for and monitor your application status.
        </p>

    </div>


    <!-- ==========================
         APPLICATIONS CARD
         ========================== -->

    <div class="applications-card">


        <!-- CARD HEADER -->

        <div class="applications-card-header">

            <h5>
                <i class="bi bi-briefcase me-2"></i>
                Application History
            </h5>


           

        </div>


        <!-- ==========================
             TABLE
             ========================== -->

        <div class="table-responsive">

            <table class="table applications-table">

                <thead>

                    <tr>

                        <th>
                            Job
                        </th>

                        <th>
                            Date Applied
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {

                        foreach (var app in Model)
                        {

                            var status =
                                app.ApplicationStatus?
                                .Trim()
                                .ToLower();

                            string statusClass =
                                status == "accepted"
                                    ? "status-accepted"
                                    : status == "rejected"
                                        ? "status-rejected"
                                        : "status-pending";


                            <tr>


                                <!-- JOB -->

                                <td>

                                    <span class="application-job-title">

                                        <i class="bi bi-briefcase me-2"></i>

                                        @(app.Job?.JobTitle ?? "Job unavailable")

                                    </span>

                                </td>


                                <!-- DATE -->

                                <td>

                                    <span class="application-date">

                                        <i class="bi bi-calendar3 me-2"></i>

                                        @app.ApplicationDate.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="application-status @statusClass">

                                        @(string.IsNullOrWhiteSpace(app.ApplicationStatus)
                                            ? "Pending"
                                            : app.ApplicationStatus)

                                    </span>

                                </td>


                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="3"
                                class="applications-empty">

                                <i class="bi bi-file-earmark-x"></i>

                                <strong>
                                    No applications yet
                                </strong>

                                <span>
                                    You have not applied for any jobs.
                                </span>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
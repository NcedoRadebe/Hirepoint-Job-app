@model HirePoint.Models.Notification

@{
    ViewData["Title"] = "Notification Details";
}

<style>

    /* =========================
           PAGE
           ========================= */

    .notification-details-page {
        background: var(--jobseeker-bg, #f5f7f6);
        min-height: 100vh;
        padding: 25px 0 40px;
    }


    /* =========================
           HEADER
           ========================= */

    .notification-details-header {
        background: var(--jobseeker-primary, #2878ad);
        color: #fff;
        border-radius: 14px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

        .notification-details-header h2 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .notification-details-header p {
            margin: 0;
            opacity: .9;
        }


    /* =========================
           MAIN CARD
           ========================= */

    .notification-details-card {
        background: #fff;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,.07);
    }


    /* =========================
           ICON
           ========================= */

    .notification-details-icon {
        width: 65px;
        height: 65px;
        border-radius: 16px;
        background: #eef5f2;
        color: #2878ad;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 20px;
    }


    /* =========================
           TITLE
           ========================= */

    .notification-details-title {
        font-weight: 700;
        color: #183b56;
        margin-bottom: 10px;
    }


    /* =========================
           DATE
           ========================= */

    .notification-details-date {
        color: #8a9290;
        font-size: 13px;
        margin-bottom: 25px;
    }


    /* =========================
           MESSAGE
           ========================= */

    .notification-details-message {
        background: #f7fafc;
        border-radius: 12px;
        padding: 22px;
        color: #495057;
        line-height: 1.8;
        white-space: pre-line;
        font-size: 15px;
    }


    /* =========================
           BACK BUTTON
           ========================= */

    .notification-back-btn {
        display: inline-block;
        margin-top: 25px;
        padding: 10px 18px;
        border-radius: 8px;
        background: #2878ad;
        border: 1px solid #2878ad;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        transition: .25s ease;
    }

        .notification-back-btn:hover {
            background: #1f638f;
            border-color: #1f638f;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(0,0,0,.12);
        }


    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 767px) {

        .notification-details-page {
            padding: 15px 0 30px;
        }

        .notification-details-header {
            padding: 22px;
        }

        .notification-details-card {
            padding: 22px;
        }
    }

</style>


<div class="notification-details-page">

    <div class="container-fluid">

        <!-- =========================
             PAGE HEADER
             ========================= -->

        <div class="notification-details-header">

            <h2>
                <i class="bi bi-bell-fill me-2"></i>
                Notification Details
            </h2>

            <p>
                View the full message from the recruiter.
            </p>

        </div>


        <!-- =========================
             NOTIFICATION
             ========================= -->

        <div class="notification-details-card">

            <!-- ICON -->

            <div class="notification-details-icon">

                <i class="bi bi-bell-fill"></i>

            </div>


            <!-- TITLE -->

            <h3 class="notification-details-title">

                @Model.Title

            </h3>


            <!-- DATE -->

            <div class="notification-details-date">

                <i class="bi bi-clock me-1"></i>

                @Model.DateCreated.ToString(
                "dd MMM yyyy, HH:mm")

            </div>


            <!-- FULL MESSAGE -->

            <div class="notification-details-message">

                @Model.Message

            </div>


            <!-- BACK BUTTON -->

            <a asp-controller="Jobseeker"
               asp-action="Notifications"
               class="notification-back-btn">

                <i class="bi bi-arrow-left me-2"></i>

                Back to Notifications

            </a>

        </div>

    </div>

</div>

@model IEnumerable<HirePoint.Models.Job>

@{
    ViewData["Title"] = "Find Jobs";

    string currentSort =
        Context.Request.Query["sort"].ToString();

    if (string.IsNullOrWhiteSpace(currentSort))
    {
        currentSort = "newest";
    }

    string currentDatePosted =
        Context.Request.Query["datePosted"].ToString();

    if (string.IsNullOrWhiteSpace(currentDatePosted))
    {
        currentDatePosted = "any";
    }
}

<style>

    /* ==========================
                               PAGE
                               ========================== */

    .jobs-page {
        background: #eef6fb;
        padding: 25px;
        border-radius: 14px;
        min-height: 100%;
    }


    /* ==========================
                               HEADER
                               ========================== */

    .jobs-header {
        margin-bottom: 22px;
        background: white;
    }

        .jobs-header h2 {
            color: black;
            font-weight: 700;
            margin-bottom: 5px;
            background: white;
        }

        .jobs-header p {
            color: black;
            margin-bottom: 0;
            background: white;
        }


    /* ==========================================
                           FIND JOBS FILTER SECTION
                           ========================================== */

    .jobs-search-card {
        background: #e5f4ff;
        border: 1px solid white;
        border-radius: 18px;
        padding: 24px;
        margin-bottom: 22px;
        box-shadow: 0 5px 18px rgba(24, 59, 86, 0.12);
        color: black;
    }



    .jobs-filter-heading {
        margin-bottom: 20px;
    }


        .jobs-filter-heading h3 {
            margin: 0 0 5px 0;
            color: black;
            font-size: 21px;
            font-weight: 700;
        }


        .jobs-filter-heading p {
            margin: 0;
            color: black;
            font-size: 14px;
        }


    /* Filter labels */

    .jobs-search-label {
        display: block;
        margin-bottom: 7px;
        color: black;
        font-size: 14px;
        font-weight: 600;
    }


    /* Search boxes and dropdowns */

    .jobs-search-input,
    .jobs-filter-select {
        width: 100%;
        min-height: 46px;
        padding: 11px 15px;
        border: 1px solid #cfe1eb;
        border-radius: 14px;
        background: #ffffff;
        color: #183b56;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }


        /* Rounded search box focus */

        .jobs-search-input:focus,
        .jobs-filter-select:focus {
            border-color: #E4FF00;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(99, 179, 237, 0.15);
        }


        /* Placeholder */

        .jobs-search-input::placeholder {
            color: #9aadb8;
        }


    /* Dropdown arrow area */

    .jobs-filter-select {
        cursor: pointer;
    }


    /* Space between filter fields */

    .jobs-filter-group {
        margin-bottom: 16px;
    }


    /* ==========================================
                           AUTOCOMPLETE
                           ========================================== */

    .job-autocomplete {
        position: absolute;
        top: calc(100% + 5px);
        left: 0;
        right: 0;
        background: #ffffff;
        border: 1px solid #d7e7f0;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(24, 59, 86, 0.12);
        z-index: 1000;
        overflow: hidden;
    }


        /* Individual autocomplete option */

        .job-autocomplete div {
            padding: 11px 14px;
            cursor: pointer;
            color: #183b56;
            font-size: 14px;
            transition: background 0.15s ease;
        }


            .job-autocomplete div:hover {
                background: #eef8fd;
            }


    /* Input wrapper */

    .autocomplete-wrapper {
        position: relative;
    }


    /* Clear button */

    .clear-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        border-radius: 14px;
        border: 1px solid #cfe1eb;
        background: #ffffff;
        color: #183b56;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }


        .clear-btn:hover {
            background: #FBFFD9;
            border-color: #FBFFD9;
            color: #183b56;
        }


    /* ==========================
                               TABLE CARD
                               ========================== */

    .jobs-table-card {
        background: #ffffff;
        border: 1px solid #d7e7f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.07);
    }


    .jobs-table-header {
        background: #2878ad;
        color: #ffffff;
        padding: 13px 17px;
    }


        .jobs-table-header h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }


    /* ==========================
                               TABLE
                               ========================== */

    .jobs-table {
        margin-bottom: 0;
    }


        .jobs-table thead th {
            background: #2878ad;
            color: #ffffff;
            border: none;
            padding: 12px 14px;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }


        .jobs-table tbody td {
            padding: 12px 14px;
            color: #3d4f5c;
            font-size: 15px;
            vertical-align: middle;
            border-color: #e5eef3;
        }


        .jobs-table tbody tr {
            transition: all 0.2s ease;
        }


            .jobs-table tbody tr:hover {
                background: #eef6fb;
            }


    /* ==========================
                               JOB TITLE
                               ========================== */

    .job-title {
        color: #183b56;
        font-weight: 600;
        font-size: 16px;
    }


    .job-location {
        color: #66737d;
    }


    /* ==========================
                               COMPANY
                               ========================== */

    .company-name {
        color: #183b56;
        font-weight: 600;
    }


    /* ==========================
                               DATE
                               ========================== */

    .date-text {
        white-space: nowrap;
        color: #4d6270;
    }


    .closing-date {
        white-space: nowrap;
        font-weight: 600;
        color: #183b56;
    }


    /* ==========================
                               DAYS LEFT
                               ========================== */

    .days-left {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 9px;
        border-radius: 20px;
        background: #eaf6ee;
        color: #24713a;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }


    .closing-soon {
        background: #fff4df;
        color: #9a6500;
    }


    /* ==========================
                               VIEW JOB BUTTON
                               ========================== */

    .view-job-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        background: #2878ad;
        color: #ffffff;
        border: 1px solid #2878ad;
        border-radius: 10px;
        text-decoration: none;
        font-size: 18px;
        cursor: pointer;
        transition: all 0.2s ease;
    }


        .view-job-btn:hover {
            background: #1f638f;
            border-color: #1f638f;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(40, 120, 173, 0.22);
        }


    /* ==========================
                               EMPTY STATE
                               ========================== */

    .jobs-empty {
        text-align: center;
        color: #71808a;
        padding: 40px !important;
    }


    /* ==========================
                               MOBILE
                               ========================== */

    @@media (max-width: 768px) {

        .jobs-page {
            padding: 15px;
        }

        .jobs-search-card {
            padding: 15px;
        }

        .search-btn,
        .clear-btn {
            width: 100%;
        }

        .job-autocomplete {
            max-height: 260px;
        }
    }

</style>


<div class="jobs-page">


    <!-- ==========================
         PAGE HEADER
         ========================== -->

    <div class="jobs-header">

        <h2>
            <i class="bi bi-search me-2"></i>
            Find Jobs
        </h2>

        <p>
            Search for available job opportunities and apply for positions that match your qualification.
        </p>

    </div>


    <!-- ==========================
         SEARCH + FILTERS
         ========================== -->

    <div class="jobs-search-card">

        <div class="jobs-filter-heading">

            <h3>
                Find the right opportunity
            </h3>

            <p>
                Search and filter jobs to find something that suits you.
            </p>

        </div>


        <form asp-controller="Jobseeker"
              asp-action="Jobs"
              method="get"
              id="jobSearchForm">

            <div class="row">

                <!-- Job Title -->

                <div class="col-md-4">

                    <div class="jobs-filter-group">

                        <label for="jobTitleInput"
                               class="jobs-search-label">
                            Job Title
                        </label>

                        <div class="autocomplete-wrapper">

                            <input type="text"
                                   id="jobTitleInput"
                                   name="title"
                                   value="@Context.Request.Query["title"]"
                                   class="jobs-search-input"
                                   placeholder="e.g. Software Developer"
                                   autocomplete="off"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Search for a specific job title, such as Software Developer or Accountant." />

                            <div id="jobTitleAutocomplete"
                                 class="job-autocomplete">
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Province -->

                <div class="col-md-4">

                    <div class="jobs-filter-group">

                        <label for="jobProvinceInput"
                               class="jobs-search-label">
                            Province
                        </label>

                        <div class="autocomplete-wrapper">

                            <input type="text"
                                   id="jobProvinceInput"
                                   name="province"
                                   value="@Context.Request.Query["province"]"
                                   class="jobs-search-input"
                                   placeholder="e.g. Eastern Cape"
                                   autocomplete="off"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Search for jobs available in a specific province." />

                            <div id="jobProvinceAutocomplete"
                                 class="job-autocomplete">
                            </div>

                        </div>

                    </div>

                </div>


                <!-- City -->

                <div class="col-md-4">

                    <div class="jobs-filter-group">

                        <label for="jobCityInput"
                               class="jobs-search-label">
                            City
                        </label>

                        <div class="autocomplete-wrapper">

                            <input type="text"
                                   id="jobCityInput"
                                   name="city"
                                   value="@Context.Request.Query["city"]"
                                   class="jobs-search-input"
                                   placeholder="e.g. Gqeberha"
                                   autocomplete="off"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Search for jobs available in a specific city." />

                            <div id="jobCityAutocomplete"
                                 class="job-autocomplete">
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="row">

                <!-- Date Posted -->

                <div class="col-md-4">

                    <div class="jobs-filter-group">

                        <label for="datePostedFilter"
                               class="jobs-search-label">
                            Date Posted
                        </label>

                        <select id="datePostedFilter"
                                name="datePosted"
                                class="jobs-filter-select"
                                data-bs-toggle="tooltip"
                                data-bs-placement="top"
                                title="Filter jobs according to when they were posted.">

                            <option value="any"
                                    selected="@(currentDatePosted == "any")">
                                Any time
                            </option>

                            <option value="today"
                                    selected="@(currentDatePosted == "today")">
                                Today
                            </option>

                            <option value="week"
                                    selected="@(currentDatePosted == "week")">
                                Past week
                            </option>

                            <option value="month"
                                    selected="@(currentDatePosted == "month")">
                                Past month
                            </option>

                        </select>

                    </div>

                </div>


                <!-- Sort By -->

                <div class="col-md-4">

                    <div class="jobs-filter-group">

                        <label for="sortFilter"
                               class="jobs-search-label">
                            Sort By
                        </label>

                        <select id="sortFilter"
                                name="sort"
                                class="jobs-filter-select"
                                data-bs-toggle="tooltip"
                                data-bs-placement="top"
                                title="Choose how the job results should be ordered.">

                            <option value="newest"
                                    selected="@(currentSort == "newest")">
                                Newest first
                            </option>

                            <option value="oldest"
                                    selected="@(currentSort == "oldest")">
                                Oldest first
                            </option>

                            <option value="salary-high"
                                    selected="@(currentSort == "salary-high")">
                                Highest salary
                            </option>

                            <option value="salary-low"
                                    selected="@(currentSort == "salary-low")">
                                Lowest salary
                            </option>

                        </select>

                    </div>

                </div>


                <!-- Clear Filters -->

                <div class="col-md-4 d-flex align-items-end">

                    <div class="jobs-filter-group">

                        <a asp-controller="Jobseeker"
                           asp-action="Jobs"
                           class="clear-btn"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Remove all selected search and filter options.">

                            Clear Filters

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>


    <!-- ==========================
         JOB TABLE
         ========================== -->

    <div class="jobs-table-card">

        <div class="jobs-table-header">

            <h5>

                <i class="bi bi-briefcase me-2"></i>

                Available Jobs

            </h5>

        </div>


        <div class="table-responsive">

            <table class="table jobs-table">

                <thead>

                    <tr>

                        <th>
                            Job Title
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Salary
                        </th>

                        <th>
                            Employment
                        </th>

                        <th>
                            Company
                        </th>

                        <th>
                            Date Posted
                        </th>

                        <th>
                            Closing Date
                        </th>

                        <th>
                            Availability
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {

                        foreach (var job in Model)
                        {

                            var daysLeft =
                                (job.ClosingDate.Date -
                                 DateTime.Today).Days;


                            <tr class="job-result-row"
                                data-job-title="@job.JobTitle"
                                data-province="@job.Province"
                                data-city="@job.City">


                                <!-- JOB TITLE -->

                                <td>

                                    <span class="job-title">
                                        @job.JobTitle
                                    </span>

                                </td>


                                <!-- LOCATION -->

                                <td>

                                    <span class="job-location">

                                        <i class="bi bi-geo-alt me-1"></i>

                                        @job.City, @job.Province

                                    </span>

                                </td>


                                <!-- SALARY -->

                                <td>
                                    @job.Salary
                                </td>


                                <!-- EMPLOYMENT -->

                                <td>
                                    @job.EmploymentType
                                </td>


                                <!-- COMPANY -->

                                <td>

                                    @if (job.Recruiter?.RecruiterProfile != null &&
                                         !string.IsNullOrWhiteSpace(
                                             job.Recruiter.RecruiterProfile.CompanyName))
                                    {

                                        <span class="company-name">

                                            <i class="bi bi-building me-1"></i>

                                            @job.Recruiter.RecruiterProfile.CompanyName

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="text-muted">
                                            Company not provided
                                        </span>

                                    }

                                </td>


                                <!-- DATE POSTED -->

                                <td>

                                    <span class="date-text">

                                        <i class="bi bi-calendar-plus me-1"></i>

                                        @job.DatePosted.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <!-- CLOSING DATE -->

                                <td>

                                    <span class="closing-date">

                                        <i class="bi bi-calendar-x me-1"></i>

                                        @job.ClosingDate.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <!-- DAYS LEFT -->

                                <td>

                                    @if (daysLeft == 0)
                                    {

                                        <span class="days-left closing-soon">

                                            <i class="bi bi-clock"></i>

                                            Closes today

                                        </span>

                                    }
                                    else if (daysLeft <= 3)
                                    {

                                        <span class="days-left closing-soon">

                                            <i class="bi bi-clock"></i>

                                            @daysLeft day(s) left

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="days-left">

                                            <i class="bi bi-check-circle"></i>

                                            @daysLeft days left

                                        </span>

                                    }

                                </td>


                                <!-- VIEW JOB -->

                                <td>

                                    <a asp-controller="Jobseeker"
                                       asp-action="JobDetails"
                                       asp-route-id="@job.JobID"
                                       class="view-job-btn"
                                       title="View the full job description, requirements, and application details."
                                       aria-label="View Job Details"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="top">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>


                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="9"
                                class="jobs-empty">

                                <i class="bi bi-briefcase me-2"></i>

                                No jobs found matching your search.

                            </td>

                        </tr>

                    }


                    <!-- LIVE FILTER NO RESULTS -->

                    <tr id="liveNoJobsMessage"
                        style="display: none;">

                        <td colspan="9"
                            class="jobs-empty">

                            <i class="bi bi-search me-2"></i>

                            No jobs found matching your search.

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     AUTOCOMPLETE SCRIPT
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        // =========================================================
        // BOOTSTRAP TOOLTIPS
        // =========================================================

        const tooltipTriggerList =
            document.querySelectorAll('[data-bs-toggle="tooltip"]');

        tooltipTriggerList.forEach(function (tooltipTriggerEl) {

            new bootstrap.Tooltip(tooltipTriggerEl);

        });


        // =========================================================
        // ELEMENTS
        // =========================================================

        const jobTitleInput =
            document.getElementById("jobTitleInput");

        const jobAutocomplete =
            document.getElementById("jobTitleAutocomplete");

        const jobProvinceInput =
            document.getElementById("jobProvinceInput");

        const jobProvinceAutocomplete =
            document.getElementById("jobProvinceAutocomplete");

        const jobCityInput =
            document.getElementById("jobCityInput");

        const jobCityAutocomplete =
            document.getElementById("jobCityAutocomplete");

        const datePostedFilter =
            document.getElementById("datePostedFilter");

        const sortFilter =
            document.getElementById("sortFilter");

        const form =
            document.getElementById("jobSearchForm");

        const jobRows =
            document.querySelectorAll(".job-result-row");

        const liveNoJobsMessage =
            document.getElementById("liveNoJobsMessage");


        // =========================================================
        // CHECK THAT IMPORTANT ELEMENTS EXIST
        // =========================================================

        if (!jobTitleInput ||
            !jobProvinceInput ||
            !jobCityInput ||
            !form) {

            console.error(
                "HirePoint: Search elements could not be found."
            );

            return;
        }


        // =========================================================
        // TIMERS
        // =========================================================

        let jobSearchTimer = null;
        let provinceSearchTimer = null;
        let citySearchTimer = null;


        // =========================================================
        // REQUEST NUMBERS
        // =========================================================

        let jobRequestNumber = 0;
        let provinceRequestNumber = 0;
        let cityRequestNumber = 0;


        // =========================================================
        // ESCAPE HTML
        // =========================================================

        function escapeHtml(value) {

            const div =
                document.createElement("div");

            div.textContent =
                value == null
                    ? ""
                    : String(value);

            return div.innerHTML;
        }


        // =========================================================
        // HIDE AUTOCOMPLETE
        // =========================================================

        function hideAutocomplete(element) {

            if (!element) {
                return;
            }

            element.innerHTML = "";

            element.classList.remove("show");
        }


        // =========================================================
        // SHOW MESSAGE
        // =========================================================

        function showMessage(element, message) {

            if (!element) {
                return;
            }

            element.innerHTML =
                '<div class="job-autocomplete-message">'
                + escapeHtml(message)
                + '</div>';

            element.classList.add("show");
        }


        // =========================================================
        // SHOW LOADING MESSAGE
        // =========================================================

        function showLoading(element, icon, message) {

            if (!element) {
                return;
            }

            element.innerHTML =
                '<div class="autocomplete-loading">'
                + '<i class="bi '
                + icon
                + ' me-1"></i>'
                + escapeHtml(message)
                + '</div>';

            element.classList.add("show");
        }


        // =========================================================
        // LIVE JOB FILTERING
        // =========================================================

        function filterJobs() {

            const title =
                jobTitleInput.value.trim().toLowerCase();

            const province =
                jobProvinceInput.value.trim().toLowerCase();

            const city =
                jobCityInput.value.trim().toLowerCase();

            let visibleJobs = 0;


            jobRows.forEach(function (row) {

                const jobTitle =
                    (row.dataset.jobTitle || "")
                        .toLowerCase();

                const jobProvince =
                    (row.dataset.province || "")
                        .toLowerCase();

                const jobCity =
                    (row.dataset.city || "")
                        .toLowerCase();


                const titleMatches =
                    title === "" ||
                    jobTitle.includes(title);


                const provinceMatches =
                    province === "" ||
                    jobProvince.includes(province);


                const cityMatches =
                    city === "" ||
                    jobCity.includes(city);


                if (
                    titleMatches &&
                    provinceMatches &&
                    cityMatches
                ) {

                    row.style.display = "";

                    visibleJobs++;

                }
                else {

                    row.style.display = "none";

                }

            });


            if (liveNoJobsMessage) {

                if (visibleJobs === 0) {

                    liveNoJobsMessage.style.display = "";

                }
                else {

                    liveNoJobsMessage.style.display = "none";

                }

            }

        }


        // =========================================================
        // SEARCH JOB TITLES
        // =========================================================

        function searchJobs(term) {

            if (!jobAutocomplete) {
                return;
            }


            const currentRequest =
                ++jobRequestNumber;


            fetch(
                '@Url.Action("SearchJobs", "Jobseeker")'
                + '?term='
                + encodeURIComponent(term),
                {
                    method: "GET",

                    headers: {
                        "X-Requested-With":
                            "XMLHttpRequest"
                    }
                }
            )

                .then(function (response) {

                    if (!response.ok) {

                        throw new Error(
                            "Job search request failed."
                        );

                    }

                    return response.json();

                })

                .then(function (results) {

                    if (
                        currentRequest !==
                        jobRequestNumber
                    ) {

                        return;
                    }


                    jobAutocomplete.innerHTML = "";


                    if (
                        !results ||
                        results.length === 0
                    ) {

                        showMessage(
                            jobAutocomplete,
                            "No matching jobs found."
                        );

                        return;
                    }


                    results.forEach(function (job) {

                        const suggestion =
                            document.createElement("div");

                        suggestion.className =
                            "job-suggestion";


                        const title =
                            document.createElement("div");

                        title.className =
                            "job-suggestion-title";

                        title.textContent =
                            job.title || "Job";


                        const details =
                            document.createElement("div");

                        details.className =
                            "job-suggestion-details";


                        const location =
                            job.location ||
                            "Location not specified";


                        details.innerHTML =
                            '<i class="bi bi-geo-alt me-1"></i>'
                            + escapeHtml(location);


                        suggestion.appendChild(title);

                        suggestion.appendChild(details);


                        suggestion.addEventListener(
                            "mousedown",
                            function (event) {

                                event.preventDefault();


                                jobTitleInput.value =
                                    job.title || "";


                                hideAutocomplete(
                                    jobAutocomplete
                                );


                                filterJobs();

                            }
                        );


                        jobAutocomplete.appendChild(
                            suggestion
                        );

                    });


                    jobAutocomplete.classList.add(
                        "show"
                    );

                })

                .catch(function (error) {

                    console.error(
                        "Job autocomplete error:",
                        error
                    );

                    hideAutocomplete(
                        jobAutocomplete
                    );

                });

        }


        // =========================================================
        // SEARCH PROVINCES
        // =========================================================

        function searchProvinces(term) {

            if (!jobProvinceAutocomplete) {
                return;
            }


            const currentRequest =
                ++provinceRequestNumber;


            fetch(
                '@Url.Action("SearchJobProvinces", "Jobseeker")'
                + '?term='
                + encodeURIComponent(term),
                {
                    method: "GET",

                    headers: {
                        "X-Requested-With":
                            "XMLHttpRequest"
                    }
                }
            )

                .then(function (response) {

                    if (!response.ok) {

                        throw new Error(
                            "Province search request failed."
                        );

                    }

                    return response.json();

                })

                .then(function (results) {

                    if (
                        currentRequest !==
                        provinceRequestNumber
                    ) {

                        return;
                    }


                    jobProvinceAutocomplete.innerHTML =
                        "";


                    if (
                        !results ||
                        results.length === 0
                    ) {

                        showMessage(
                            jobProvinceAutocomplete,
                            "No matching provinces found."
                        );

                        return;
                    }


                    results.forEach(function (province) {

                        const suggestion =
                            document.createElement("div");

                        suggestion.className =
                            "job-suggestion";


                        const title =
                            document.createElement("div");

                        title.className =
                            "job-suggestion-title";


                        title.innerHTML =
                            '<i class="bi bi-map me-1"></i>'
                            + escapeHtml(
                                province.value
                            );


                        suggestion.appendChild(title);


                        suggestion.addEventListener(
                            "mousedown",
                            function (event) {

                                event.preventDefault();


                                jobProvinceInput.value =
                                    province.value || "";


                                hideAutocomplete(
                                    jobProvinceAutocomplete
                                );


                                filterJobs();

                            }
                        );


                        jobProvinceAutocomplete.appendChild(
                            suggestion
                        );

                    });


                    jobProvinceAutocomplete.classList.add(
                        "show"
                    );

                })

                .catch(function (error) {

                    console.error(
                        "Province autocomplete error:",
                        error
                    );

                    hideAutocomplete(
                        jobProvinceAutocomplete
                    );

                });

        }


        // =========================================================
        // SEARCH CITIES
        // =========================================================

        function searchCities(term) {

            if (!jobCityAutocomplete) {
                return;
            }


            const currentRequest =
                ++cityRequestNumber;


            fetch(
                '@Url.Action("SearchJobCities", "Jobseeker")'
                + '?term='
                + encodeURIComponent(term),
                {
                    method: "GET",

                    headers: {
                        "X-Requested-With":
                            "XMLHttpRequest"
                    }
                }
            )

                .then(function (response) {

                    if (!response.ok) {

                        throw new Error(
                            "City search request failed."
                        );

                    }

                    return response.json();

                })

                .then(function (results) {

                    if (
                        currentRequest !==
                        cityRequestNumber
                    ) {

                        return;
                    }


                    jobCityAutocomplete.innerHTML =
                        "";


                    if (
                        !results ||
                        results.length === 0
                    ) {

                        showMessage(
                            jobCityAutocomplete,
                            "No matching cities found."
                        );

                        return;
                    }


                    results.forEach(function (city) {

                        const suggestion =
                            document.createElement("div");

                        suggestion.className =
                            "job-suggestion";


                        const title =
                            document.createElement("div");

                        title.className =
                            "job-suggestion-title";


                        title.innerHTML =
                            '<i class="bi bi-geo-alt me-1"></i>'
                            + escapeHtml(
                                city.value
                            );


                        suggestion.appendChild(title);


                        suggestion.addEventListener(
                            "mousedown",
                            function (event) {

                                event.preventDefault();


                                jobCityInput.value =
                                    city.value || "";


                                hideAutocomplete(
                                    jobCityAutocomplete
                                );


                                filterJobs();

                            }
                        );


                        jobCityAutocomplete.appendChild(
                            suggestion
                        );

                    });


                    jobCityAutocomplete.classList.add(
                        "show"
                    );

                })

                .catch(function (error) {

                    console.error(
                        "City autocomplete error:",
                        error
                    );

                    hideAutocomplete(
                        jobCityAutocomplete
                    );

                });

        }


        // =========================================================
        // JOB TITLE INPUT
        // =========================================================

        if (
            jobTitleInput &&
            jobAutocomplete
        ) {

            jobTitleInput.addEventListener(
                "input",
                function () {

                    filterJobs();


                    const term =
                        jobTitleInput.value.trim();


                    clearTimeout(
                        jobSearchTimer
                    );


                    if (term.length < 2) {

                        hideAutocomplete(
                            jobAutocomplete
                        );

                        return;
                    }


                    showLoading(
                        jobAutocomplete,
                        "bi-search",
                        "Searching jobs..."
                    );


                    jobSearchTimer =
                        setTimeout(
                            function () {

                                searchJobs(term);

                            },
                            250
                        );

                }
            );


            jobTitleInput.addEventListener(
                "focus",
                function () {

                    const term =
                        jobTitleInput.value.trim();


                    if (term.length >= 2) {

                        searchJobs(term);

                    }

                }
            );


            jobTitleInput.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        hideAutocomplete(
                            jobAutocomplete
                        );

                        jobTitleInput.blur();

                    }

                }
            );

        }


        // =========================================================
        // PROVINCE INPUT
        // =========================================================

        if (
            jobProvinceInput &&
            jobProvinceAutocomplete
        ) {

            jobProvinceInput.addEventListener(
                "input",
                function () {

                    filterJobs();


                    const term =
                        jobProvinceInput.value.trim();


                    clearTimeout(
                        provinceSearchTimer
                    );


                    if (term.length < 2) {

                        hideAutocomplete(
                            jobProvinceAutocomplete
                        );

                        return;
                    }


                    showLoading(
                        jobProvinceAutocomplete,
                        "bi-map",
                        "Searching provinces..."
                    );


                    provinceSearchTimer =
                        setTimeout(
                            function () {

                                searchProvinces(term);

                            },
                            250
                        );

                }
            );


            jobProvinceInput.addEventListener(
                "focus",
                function () {

                    const term =
                        jobProvinceInput.value.trim();


                    if (term.length >= 2) {

                        searchProvinces(term);

                    }

                }
            );


            jobProvinceInput.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        hideAutocomplete(
                            jobProvinceAutocomplete
                        );

                        jobProvinceInput.blur();

                    }

                }
            );

        }


        // =========================================================
        // CITY INPUT
        // =========================================================

        if (
            jobCityInput &&
            jobCityAutocomplete
        ) {

            jobCityInput.addEventListener(
                "input",
                function () {

                    filterJobs();


                    const term =
                        jobCityInput.value.trim();


                    clearTimeout(
                        citySearchTimer
                    );


                    if (term.length < 2) {

                        hideAutocomplete(
                            jobCityAutocomplete
                        );

                        return;
                    }


                    showLoading(
                        jobCityAutocomplete,
                        "bi-geo-alt",
                        "Searching cities..."
                    );


                    citySearchTimer =
                        setTimeout(
                            function () {

                                searchCities(term);

                            },
                            250
                        );

                }
            );


            jobCityInput.addEventListener(
                "focus",
                function () {

                    const term =
                        jobCityInput.value.trim();


                    if (term.length >= 2) {

                        searchCities(term);

                    }

                }
            );


            jobCityInput.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        hideAutocomplete(
                            jobCityAutocomplete
                        );

                        jobCityInput.blur();

                    }

                }
            );

        }


        // =========================================================
        // DATE POSTED FILTER
        // =========================================================

        if (datePostedFilter) {

            datePostedFilter.addEventListener(
                "change",
                function () {

                    form.submit();

                }
            );

        }


        // =========================================================
        // SORT FILTER
        // =========================================================

        if (sortFilter) {

            sortFilter.addEventListener(
                "change",
                function () {

                    form.submit();

                }
            );

        }


        // =========================================================
        // CLICK OUTSIDE AUTOCOMPLETE
        // =========================================================

        document.addEventListener(
            "click",
            function (event) {

                if (
                    !event.target.closest(
                        "#jobTitleInput"
                    ) &&
                    !event.target.closest(
                        "#jobTitleAutocomplete"
                    )
                ) {

                    hideAutocomplete(
                        jobAutocomplete
                    );

                }


                if (
                    !event.target.closest(
                        "#jobProvinceInput"
                    ) &&
                    !event.target.closest(
                        "#jobProvinceAutocomplete"
                    )
                ) {

                    hideAutocomplete(
                        jobProvinceAutocomplete
                    );

                }


                if (
                    !event.target.closest(
                        "#jobCityInput"
                    ) &&
                    !event.target.closest(
                        "#jobCityAutocomplete"
                    )
                ) {

                    hideAutocomplete(
                        jobCityAutocomplete
                    );

                }

            }
        );


        // =========================================================
        // INITIAL FILTER
        // =========================================================

        filterJobs();


        console.log(
            "HirePoint job filters loaded successfully."
        );

    });

</script>
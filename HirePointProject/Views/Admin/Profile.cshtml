@model HirePoint.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<style>

    /* ==========================
               PROFILE PAGE
               ========================== */

    .profile-page {
        background: #eef6fb;
        padding: 25px;
        border-radius: 14px;
        min-height: 100%;
    }


    /* ==========================
               PAGE HEADER
               ========================== */

    .profile-header {
        margin-bottom: 22px;
    }

        .profile-header h2 {
            color: #183b56;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .profile-header p {
            color: #66737d;
            margin-bottom: 0;
        }


    /* ==========================
               SUCCESS MESSAGE
               ========================== */

    .profile-success {
        background: #2878ad;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 11px 15px;
        margin-bottom: 18px;
        box-shadow: 0 3px 10px rgba(40, 120, 173, 0.15);
    }


    /* ==========================
               PROFILE CARD
               ========================== */

    .profile-card {
        background: #ffffff;
        border: 1px solid #d7e7f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.08);
    }


    /* ==========================
               CARD HEADER
               ========================== */

    .profile-card-header {
        background: #2878ad;
        color: #ffffff;
        padding: 14px 18px;
    }

        .profile-card-header h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }


    /* ==========================
               CARD BODY
               ========================== */

    .profile-card-body {
        padding: 22px;
    }


    /* ==========================
               FORM LABELS
               ========================== */

    .profile-form label {
        color: #183b56;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
    }


    /* ==========================
               INPUTS
               ========================== */

    .profile-form .form-control {
        border: 1px solid #d7e7f0;
        border-radius: 7px;
        padding: 9px 11px;
        font-size: 14px;
        color: #3d4f5c;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .profile-form .form-control:focus {
            border-color: #2878ad;
            box-shadow: 0 0 0 0.2rem rgba(40, 120, 173, 0.15);
            outline: none;
        }

        .profile-form .form-control:hover {
            border-color: #2878ad;
        }


    /* ==========================
               USER ID
               ========================== */

    .profile-user-id {
        background: #eef6fb;
        border: 1px solid #d7e7f0;
        color: #2878ad;
        border-radius: 7px;
        padding: 9px 11px;
        font-size: 14px;
        font-weight: 600;
    }


    /* ==========================
               SAVE BUTTON
               ========================== */

    .profile-save-button {
        background: #2878ad;
        border: 1px solid #2878ad;
        color: #ffffff;
        border-radius: 7px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .profile-save-button:hover {
            background: #1f638f;
            border-color: #1f638f;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(40, 120, 173, 0.2);
        }


    /* ==========================
               RESPONSIVE
               ========================== */

    @@media (max-width: 768px) {

        .profile-page {
            padding: 15px;
        }

        .profile-card-body {
            padding: 16px;
        }
    }

</style>


<div class="profile-page">

    <!-- ==========================
         PAGE HEADER
         ========================== -->

    <div class="profile-header">

        <h2>
            <i class="bi bi-person-circle me-2"></i>
            My Profile
        </h2>

        <p>
            Update your personal account information.
        </p>

    </div>


    <!-- ==========================
         SUCCESS MESSAGE
         ========================== -->
    @if (TempData["Success"] != null)
    {
        <div class="profile-success">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

        </div>
    }


    <!-- ==========================
         PROFILE CARD
         ========================== -->

    <div class="profile-card">

        <!-- CARD HEADER -->

        <div class="profile-card-header">

            <h5>
                <i class="bi bi-person-gear me-2"></i>
                Account Information
            </h5>

        </div>


        <!-- CARD BODY -->

        <div class="profile-card-body">

            <form asp-action="Profile"
                  asp-controller="Admin"
                  method="post"
                  class="profile-form">

                @Html.AntiForgeryToken()


                <!-- USER ID -->

                <input type="hidden"
                       asp-for="UserID" />


                <div class="mb-3">

                    <label>
                        User ID
                    </label>

                    <div class="profile-user-id">

                        #@Model.UserID

                    </div>

                </div>


                <!-- NAME -->

                <div class="mb-3">

                    <label asp-for="FullName">
                        Name
                    </label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Enter your full name" />

                    <span asp-validation-for="FullName"
                          class="text-danger">
                    </span>

                </div>


                <!-- EMAIL -->

                <div class="mb-3">

                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email address" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- PHONE -->

                <div class="mb-3">

                    <label asp-for="PhoneNumber">
                        Phone
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="Enter your phone number" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- GENDER -->

                <div class="mb-3">

                    <label asp-for="Gender">
                        Gender
                    </label>

                    <input asp-for="Gender"
                           class="form-control"
                           placeholder="Enter your gender" />

                    <span asp-validation-for="Gender"
                          class="text-danger">
                    </span>

                </div>


                <!-- BUTTON -->

                <div class="d-flex justify-content-end pt-2">

                    <button type="submit"
                            class="btn profile-save-button">

                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

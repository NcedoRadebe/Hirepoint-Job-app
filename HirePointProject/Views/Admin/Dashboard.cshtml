@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- ==========================
     HEADER
     ========================== -->

<div class="admin-dashboard">

    
    <div class="admin-dashboard-header">

        <div>
            <h2>
                <i class="bi bi-speedometer2 me-2"></i>
                Admin Dashboard
            </h2>

            <p class="mb-0">
                Manage users, jobs and platform activity.
            </p>
        </div>

    </div>


    <!-- ==========================
      STATISTICS
      ========================== -->

    <div class="row g-4 mb-4">

        <!-- TOTAL USERS -->

        <div class="col-lg-4 col-md-6">

            <div class="admin-stat-card">

                <div class="admin-stat-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h5>
                    Total Users
                </h5>

                <h2>
                    @ViewBag.TotalUsers
                </h2>

            </div>

        </div>


        <!-- ACTIVE JOBS -->

        <div class="col-lg-4 col-md-6">

            <div class="admin-stat-card">

                <div class="admin-stat-icon">
                    <i class="bi bi-briefcase"></i>
                </div>

                <h5>
                    Active Jobs
                </h5>

                <h2>
                    @ViewBag.ActiveJobs
                </h2>

            </div>

        </div>


        <!-- APPLICATIONS -->

        <div class="col-lg-4 col-md-6">

            <div class="admin-stat-card">

                <div class="admin-stat-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <h5>
                    Applications
                </h5>

                <h2>
                    @ViewBag.Applications
                </h2>

            </div>

        </div>

    </div>


    <!-- ==========================
     TABLES
     ========================== -->

    <div class="row g-4">


        <!-- ==========================
         RECENT USERS
         ========================== -->

        <div class="col-lg-6">

            <div class="admin-card">

                <div class="admin-card-header">

                    <h5>
                        <i class="bi bi-people me-2"></i>
                        Recent Users
                    </h5>

                </div>


                <div class="admin-card-body p-0">

                    <div class="table-responsive">

                        <table class="table admin-table mb-0">

                            <thead>

                                <tr>

                                    <th>Name</th>

                                    <th>Email</th>

                                    <th>Type</th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (ViewBag.RecentUsers != null &&
                                     ViewBag.RecentUsers.Count > 0)
                                {
                                    foreach (var user in ViewBag.RecentUsers)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @user.FullName
                                                </strong>
                                            </td>

                                            <td>
                                                @user.Email
                                            </td>

                                            <td>
                                                <span class="user-type">
                                                    @user.UserType
                                                </span>
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="3"
                                            class="empty-table text-center">

                                            No users found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==========================
         RECENT JOBS
         ========================== -->

        <div class="col-lg-6">

            <div class="admin-card">

                <div class="admin-card-header">

                    <h5>
                        <i class="bi bi-briefcase me-2"></i>
                        Recent Jobs
                    </h5>

                </div>


                <div class="admin-card-body p-0">

                    <div class="table-responsive">

                        <table class="table admin-table mb-0">

                            <thead>

                                <tr>

                                    <th>
                                        Job Title
                                    </th>

                                    <th>
                                        Company
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (ViewBag.RecentJobs != null &&
                                     ViewBag.RecentJobs.Count > 0)
                                {
                                    foreach (var job in ViewBag.RecentJobs)
                                    {
                                        <tr>

                                            <!-- JOB TITLE -->

                                            <td>
                                                <strong>
                                                    @job.JobTitle
                                                </strong>
                                            </td>


                                            <!-- COMPANY -->

                                            <td>

                                                @if (job.Company != null &&
                                                     !string.IsNullOrWhiteSpace(
                                                         job.Company.CompanyName))
                                                {
                                                    <strong>
                                                        @job.Company.CompanyName
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Company not provided
                                                    </span>
                                                }

                                            </td>


                                            <!-- STATUS -->

                                            <td>

                                                @if (string.Equals(
                                                    job.JobStatus,
                                                    "Active",
                                                    StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="active-status">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="other-status">
                                                        @job.JobStatus
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="3"
                                            class="empty-table text-center">

                                            No jobs found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- =====================================================
     ADMIN DASHBOARD CSS
     ===================================================== -->

<style>

    .admin-dashboard {
        background: #ffffff;
        min-height: 100vh;
        padding: 20px;
        border-radius: 12px;
    }


    .admin-dashboard-header {
        background: #ffffff;
        border-radius: 10px;
        padding: 18px 22px;
        margin-bottom: 20px;
        box-shadow: 0 3px 12px rgba(245, 254, 255, 0.08);
    }


        .admin-dashboard-header h2 {
            color: #2878ad;
            font-weight: 700;
            font-size: 24px;
            margin-bottom: 4px;
        }


        .admin-dashboard-header p {
            color: #6c757d;
            font-size: 14px;
        }


    .admin-stat-card {
        background: #FBFFD9;
        border: 1px solid #FBFFD9;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.07);
        transition: all 0.2s ease;
    }

        .admin-stat-card:hover {
            transform: translateY(-3px);
            border-color: #E4FF00;
            box-shadow: 0 6px 16px rgba(40, 120, 173, 0.16);
        }

    .admin-stat-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef6fb;
        color: #333615;
        border-radius: 9px;
        font-size: 20px;
        margin-bottom: 12px;
    }

    .admin-stat-card h5 {
        color: #183b56;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .admin-stat-card h2 {
        color: #2878ad;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 0;
    }


    .admin-card {
        background: #ffffff;
        border-radius: 10px;
        border: 1px solid #d9eaf5;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(40, 120, 173, 0.08);
    }


    .admin-card-header {
        background: #2878ad;
        color: #ffffff;
        padding: 14px 18px;
    }


        .admin-card-header h5 {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
        }


    .admin-card-body {
        padding: 18px;
    }


    .admin-table {
        margin-bottom: 0;
    }


        .admin-table thead th {
            background: #2878ad;
            color: #ffffff;
            border: none;
            padding: 12px 15px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }


        .admin-table tbody td {
            padding: 13px 15px;
            vertical-align: middle;
            border-color: #e8f1f6;
            color: #444444;
            font-size: 13px;
        }


        .admin-table tbody tr {
            transition: background-color 0.2s ease;
        }


            .admin-table tbody tr:hover {
                background: #eef8fd;
            }


    .active-status {
        display: inline-block;
        background: #e4f5eb;
        color: #21874b;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }


    .other-status {
        display: inline-block;
        background: #eef1f4;
        color: #66727c;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }


    .user-type {
        display: inline-block;
        background: #e4f2fa;
        color: #2878ad;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }


    .quick-actions-card {
        height: 100%;
    }


    .quick-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }


    .admin-action-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 9px 13px;
        border-radius: 7px;
        background: #e4f2fa;
        color: #2878ad;
        border: 1px solid #c9e3f1;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.25s ease;
    }


        .admin-action-button:hover {
            background: #2878ad;
            color: #ffffff;
            border-color: #2878ad;
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(40, 120, 173, 0.18);
        }


    .empty-table {
        padding: 25px !important;
        color: #7b8790;
    }


    @@media (max-width: 768px) {

        .admin-dashboard {
            padding: 12px;
        }

        .admin-dashboard-header {
            padding: 15px;
        }

            .admin-dashboard-header h2 {
                font-size: 20px;
            }

        .admin-stat-body {
            padding: 13px 15px;
        }

        .admin-stat-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            font-size: 16px;
        }

        .admin-stat-body h2 {
            font-size: 21px;
        }

        .admin-stat-body h6 {
            font-size: 11px;
        }
    }

</style>

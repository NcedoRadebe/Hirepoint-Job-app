@model IEnumerable<HirePoint.Models.User>

@{
    ViewData["Title"] = "Recruiter Approvals";

    bool isSystemAdministrator =
        ViewBag.IsSystemAdministrator is bool value && value;
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-check-fill me-2"></i>
                Recruiter Approvals
            </h2>

            <p class="text-muted mb-0">
                Review pending recruiters and verify their company representatives.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="RecruiterApprovals"
           class="btn btn-outline-secondary"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           title="Refresh the list of pending recruiter approvals.">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
        </a>
    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert"
             data-bs-toggle="tooltip"
             data-bs-placement="top"
             title="This message confirms that the previous recruiter approval action was completed successfully.">
            <i class="bi bi-check-circle-fill me-2"></i>

            <strong>
                @(TempData["Success"] ?? TempData["SuccessMessage"])
            </strong>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Close this message.">
            </button>
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert"
             data-bs-toggle="tooltip"
             data-bs-placement="top"
             title="This message explains an error that occurred while processing the recruiter approval.">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            <strong>
                @(TempData["Error"] ?? TempData["ErrorMessage"])
            </strong>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Close this message.">
            </button>
        </div>
    }


    <!-- SYSTEM ADMINISTRATOR NOTICE -->
    @if (isSystemAdministrator)
    {
        <div class="alert alert-info mb-4"
             data-bs-toggle="tooltip"
             data-bs-placement="top"
             title="System administrators can review pending recruiters and send company representative verification emails.">
            <div class="d-flex align-items-start">

                <i class="bi bi-shield-check fs-4 me-3"></i>

                <div>
                    <strong>System Administrator</strong>

                    <div class="mt-1">
                        You can view all pending recruiters and send
                        company representative verification emails.
                    </div>
                </div>

            </div>
        </div>
    }


    <!-- NO RECRUITERS -->
    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-people fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No Pending Recruiters
                </h5>

                <p class="text-muted mb-0">
                    There are currently no recruiters waiting for approval.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var recruiter in Model)
            {
                var profile = recruiter.RecruiterProfile;

                string recruiterName =
                    string.IsNullOrWhiteSpace(recruiter.FullName)
                        ? "Name not provided"
                        : recruiter.FullName;

                string recruiterEmail =
                    string.IsNullOrWhiteSpace(recruiter.Email)
                        ? "Not provided"
                        : recruiter.Email;

                string companyName =
                    string.IsNullOrWhiteSpace(profile?.CompanyName)
                        ? "Company not provided"
                        : profile.CompanyName;

                string representativeName =
                    string.IsNullOrWhiteSpace(profile?.RepresentativeName)
                        ? "Not provided"
                        : profile.RepresentativeName;

                string representativeEmail =
                    string.IsNullOrWhiteSpace(profile?.RepresentativeEmail)
                        ? "Not provided"
                        : profile.RepresentativeEmail;

                string verificationStatus =
                    string.IsNullOrWhiteSpace(
                        profile?.RepresentativeVerificationStatus)
                            ? "Pending"
                            : profile.RepresentativeVerificationStatus;

                bool representativeVerified =
                    string.Equals(
                        verificationStatus,
                        "Verified",
                        StringComparison.OrdinalIgnoreCase);

                bool representativeNotVerified =
                    string.Equals(
                        verificationStatus,
                        "Not Verified",
                        StringComparison.OrdinalIgnoreCase);


                <!-- RECRUITER CARD -->
                <div class="col-12">

                    <div class="card border-0 shadow-sm">

                        <!-- CARD HEADER -->
                        <div class="card-header bg-white py-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h5 class="fw-bold mb-1"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        title="The name of the recruiter requesting approval.">

                                        <i class="bi bi-person-badge me-2"></i>

                                        @recruiterName

                                    </h5>

                                    <small class="text-muted"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="The unique user ID assigned to this recruiter.">
                                        Recruiter ID:
                                        <strong>@recruiter.UserID</strong>
                                    </small>
                                </div>

                                <span class="badge bg-warning text-dark"
                                      data-bs-toggle="tooltip"
                                      data-bs-placement="top"
                                      title="This recruiter is currently waiting for approval.">
                                    <i class="bi bi-clock me-1"></i>
                                    Pending
                                </span>

                            </div>

                        </div>


                        <!-- CARD BODY -->
                        <div class="card-body">

                            <div class="row g-4">

                                <!-- RECRUITER INFORMATION -->
                                <div class="col-md-4">

                                    <h6 class="fw-bold mb-3">
                                        <i class="bi bi-person me-2"></i>
                                        Recruiter Information
                                    </h6>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Full Name
                                        </small>

                                        <strong data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="The recruiter's full name.">
                                            @recruiterName
                                        </strong>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Email
                                        </small>

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The email address associated with the recruiter's account.">
                                            @recruiterEmail
                                        </span>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            User Type
                                        </small>

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The account type assigned to this user.">
                                            @(recruiter.UserType ?? "Recruiter")
                                        </span>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Account Status
                                        </small>

                                        <span class="badge bg-warning text-dark"
                                              data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The current approval status of the recruiter's account.">
                                            @(recruiter.Status ?? "Pending")
                                        </span>
                                    </div>

                                </div>


                                <!-- COMPANY INFORMATION -->
                                <div class="col-md-4">

                                    <h6 class="fw-bold mb-3">
                                        <i class="bi bi-building me-2"></i>
                                        Company Information
                                    </h6>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Requested Company
                                        </small>

                                        <strong data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="The company this recruiter requested to join.">
                                            @companyName
                                        </strong>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Company ID
                                        </small>

                                        @if (recruiter.CompanyID.HasValue)
                                        {
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="The company ID associated with this recruiter.">
                                                @recruiter.CompanyID.Value
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="No company has currently been assigned to this recruiter account.">
                                                Not assigned
                                            </span>
                                        }
                                    </div>

                                </div>


                                <!-- REPRESENTATIVE INFORMATION -->
                                <div class="col-md-4">

                                    <h6 class="fw-bold mb-3">
                                        <i class="bi bi-person-vcard me-2"></i>
                                        Company Representative
                                    </h6>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Representative Name
                                        </small>

                                        <strong data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="The company representative associated with this recruiter request.">
                                            @representativeName
                                        </strong>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Representative Email
                                        </small>

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The email address that receives the representative verification email.">
                                            @representativeEmail
                                        </span>
                                    </div>

                                </div>

                            </div>


                            <hr class="my-4" />


                            <!-- REPRESENTATIVE VERIFICATION -->
                            <div>

                                <h6 class="fw-bold mb-3">
                                    <i class="bi bi-envelope-check me-2"></i>
                                    Representative Verification
                                </h6>


                                @if (representativeVerified)
                                {
                                    <div class="alert alert-success"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="The company representative has completed verification for this recruiter.">

                                        <i class="bi bi-check-circle-fill me-2"></i>

                                        <strong>
                                            Representative Verified
                                        </strong>

                                        <div class="small mt-1">
                                            The company representative has verified
                                            this recruiter.
                                        </div>

                                    </div>
                                }
                                else if (representativeNotVerified)
                                {
                                    <div class="alert alert-danger"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="The company representative has not completed the required verification.">

                                        <i class="bi bi-x-circle-fill me-2"></i>

                                        <strong>
                                            Representative Not Verified
                                        </strong>

                                        <div class="small mt-1">
                                            The representative has not verified
                                            the recruiter.
                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="Verification is still pending and a verification email can be sent to the company representative.">

                                        <i class="bi bi-clock-fill me-2"></i>

                                        <strong>
                                            Verification Pending
                                        </strong>

                                        <div class="small mt-1">
                                            Send a verification email to the
                                            company representative.
                                        </div>

                                    </div>
                                }


                                <!-- VERIFY REPRESENTATIVE -->
                                @if (!representativeVerified)
                                {
                                    <form asp-controller="Admin"
                                          asp-action="VerifyRepresentative"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@recruiter.UserID" />

                                        @if (representativeNotVerified)
                                        {
                                            <button type="submit"
                                                    class="btn btn-warning"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    title="Send another verification email to the company representative.">

                                                <i class="bi bi-envelope-arrow-up me-1"></i>

                                                Resend Verification Email

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-primary"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    title="Send a verification email to the company representative.">

                                                <i class="bi bi-envelope-check me-1"></i>

                                                Verify Representative

                                            </button>
                                        }

                                    </form>

                                    <div class="small text-muted mt-2"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="The verification email will be sent to the representative email address shown above.">

                                        <i class="bi bi-info-circle me-1"></i>

                                        This sends a verification email to:

                                        <strong>
                                            @representativeEmail
                                        </strong>

                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-success"
                                            disabled
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="The company representative has already been verified.">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Representative Verified

                                    </button>
                                }

                            </div>


                            <hr class="my-4" />


                            <!-- RECRUITER APPROVAL -->
                            <div>

                                <h6 class="fw-bold mb-3">
                                    <i class="bi bi-shield-check me-2"></i>
                                    Recruiter Approval
                                </h6>


                                @if (representativeVerified)
                                {
                                    <form asp-controller="Admin"
                                          asp-action="ApproveRecruiter"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@recruiter.UserID" />

                                        <button type="submit"
                                                class="btn btn-success"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Approve this recruiter and activate the recruiter's account.">

                                            <i class="bi bi-check-lg me-1"></i>

                                            Approve Recruiter

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-success"
                                            disabled
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="The recruiter cannot be approved until the company representative completes verification.">

                                        <i class="bi bi-lock me-1"></i>

                                        Approve Recruiter

                                    </button>
                                }


                                <form asp-controller="Admin"
                                      asp-action="RejectRecruiter"
                                      method="post"
                                      class="d-inline ms-2"
                                      onsubmit="return confirm('Are you sure you want to reject this recruiter?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@recruiter.UserID" />

                                    <button type="submit"
                                            class="btn btn-danger"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Reject this recruiter approval request.">

                                        <i class="bi bi-x-lg me-1"></i>

                                        Reject Recruiter

                                    </button>

                                </form>


                                @if (!representativeVerified)
                                {
                                    <div class="small text-muted mt-3"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="Recruiter approval remains unavailable until representative verification is completed.">

                                        <i class="bi bi-info-circle me-1"></i>

                                        The recruiter can only be approved after
                                        the company representative verifies the
                                        verification email.

                                    </div>
                                }
                                else
                                {
                                    <div class="small text-success mt-3"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="Representative verification has been completed, so the recruiter approval action is available.">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Representative verification is complete.
                                        The recruiter can now be approved.

                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                    <style>
                                    /* =========================================
                                                                   HIREPOINT RECRUITER APPROVALS
                                                                   ========================================= */

                                    /* Page background */
                                    .container-fluid {
                                        background: #eef6fb;
                                        min-height: calc(100vh - 80px);
                                        border-radius: 14px;
                                        padding: 25px !important;
                                    }

                                        /* =========================================
                                                                   PAGE HEADER
                                                                   ========================================= */

                                        .container-fluid > .d-flex:first-child h2 {
                                            color: #183b56;
                                        }

                                            .container-fluid > .d-flex:first-child h2 i {
                                                color: #2878ad;
                                            }

                                        /* Refresh button */
                                        .container-fluid > .d-flex:first-child .btn-outline-secondary {
                                            border: 1px solid #2878ad;
                                            color: #2878ad;
                                            border-radius: 10px;
                                            padding: 9px 18px;
                                            font-weight: 600;
                                            transition: all 0.2s ease;
                                        }

                                            .container-fluid > .d-flex:first-child .btn-outline-secondary:hover {
                                                background: #2878ad;
                                                border-color: #2878ad;
                                                color: white;
                                                transform: translateY(-1px);
                                            }

                                    /* =========================================
                                                                   ALERTS
                                                                   ========================================= */

                                    .alert {
                                        border-radius: 12px;
                                        border: none;
                                        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.06);
                                    }

                                    /* System Administrator notice */
                                    .alert-info {
                                        background: #e4f4fc;
                                        color: #183b56;
                                        border-left: 5px solid #2878ad;
                                    }

                                        .alert-info i {
                                            color: #2878ad;
                                        }

                                    /* Success */
                                    .alert-success {
                                        background: #eef9e8;
                                        color: #285c35;
                                        border-left: 5px solid #5a9f4a;
                                    }

                                    /* Error */
                                    .alert-danger {
                                        background: #fff0f0;
                                        color: #7a2525;
                                        border-left: 5px solid #d9534f;
                                    }

                                    /* Warning */
                                    .alert-warning {
                                        background: #fff8c6;
                                        color: #5f5316;
                                        border: 1px solid #e6d98c;
                                    }

                                    /* =========================================
                                                                   RECRUITER CARD
                                                                   ========================================= */

                                    .row.g-4 > .col-12 > .card {
                                        border: 1px solid #e5edf2 !important;
                                        border-radius: 16px;
                                        overflow: hidden;
                                        background: white;
                                        box-shadow: 0 4px 14px rgba(24, 59, 86, 0.08) !important;
                                        transition: all 0.25s ease;
                                    }

                                        .row.g-4 > .col-12 > .card:hover {
                                            transform: translateY(-3px);
                                            box-shadow: 0 8px 22px rgba(24, 59, 86, 0.12) !important;
                                        }

                                        /* =========================================
                                                                   CARD HEADER
                                                                   ========================================= */

                                        .row.g-4 > .col-12 > .card .card-header {
                                            background: #FBFFD9 !important;
                                            border-bottom: 1px solid #E6D98C;
                                            padding: 18px 22px !important;
                                        }

                                    .card-header h5 {
                                        color: #183b56;
                                    }

                                        .card-header h5 i {
                                            color: #2878ad;
                                        }

                                    /* =========================================
                                                                   PENDING BADGE
                                                                   ========================================= */

                                    .badge.bg-warning {
                                        background: #f6e98b !important;
                                        color: #5f5316 !important;
                                        border-radius: 20px;
                                        padding: 7px 12px;
                                        font-weight: 600;
                                    }

                                    .badge.bg-primary {
                                        background: #2878ad !important;
                                        border-radius: 20px;
                                        padding: 7px 12px;
                                    }

                                    /* =========================================
                                                                   CARD BODY
                                                                   ========================================= */

                                    .row.g-4 > .col-12 > .card .card-body {
                                        padding: 24px;
                                    }

                                    /* Section headings */
                                    .card-body h6 {
                                        color: #183b56;
                                        font-size: 15px;
                                    }

                                        .card-body h6 i {
                                            color: #2878ad;
                                        }

                                    /* Information labels */
                                    .card-body small.text-muted {
                                        color: #71808c !important;
                                        font-size: 12px;
                                        margin-bottom: 3px;
                                    }

                                    /* Information values */
                                    .card-body strong {
                                        color: #183b56;
                                    }

                                    /* =========================================
                                                                   SEPARATORS
                                                                   ========================================= */

                                    .card-body hr {
                                        border: 0;
                                        border-top: 1px solid #e6edf2;
                                        opacity: 1;
                                    }

                                    /* =========================================
                                                                   VERIFICATION / APPROVAL BUTTONS
                                                                   ========================================= */

                                    .card-body .btn {
                                        border-radius: 10px;
                                        padding: 9px 16px;
                                        font-weight: 600;
                                        transition: all 0.2s ease;
                                    }

                                    /* Primary button */
                                    .card-body .btn-primary {
                                        background: #2878ad;
                                        border-color: #2878ad;
                                    }

                                        .card-body .btn-primary:hover {
                                            background: #1e6090;
                                            border-color: #1e6090;
                                            transform: translateY(-1px);
                                        }

                                    /* Success button */
                                    .card-body .btn-success {
                                        background: #5a9f4a;
                                        border-color: #5a9f4a;
                                    }

                                        .card-body .btn-success:hover {
                                            background: #4b893e;
                                            border-color: #4b893e;
                                            transform: translateY(-1px);
                                        }

                                    /* Warning button */
                                    .card-body .btn-warning {
                                        background: #f2df6b;
                                        border-color: #e6d35a;
                                        color: #4f4614;
                                    }

                                        .card-body .btn-warning:hover {
                                            background: #e6d35a;
                                            border-color: #d8c84f;
                                            color: #3f3810;
                                            transform: translateY(-1px);
                                        }

                                    /* Danger button */
                                    .card-body .btn-danger {
                                        background: #d9534f;
                                        border-color: #d9534f;
                                    }

                                        .card-body .btn-danger:hover {
                                            background: #c64541;
                                            border-color: #c64541;
                                            transform: translateY(-1px);
                                        }

                                    /* =========================================
                                                                   DISABLED APPROVE BUTTON
                                                                   ========================================= */

                                    .card-body .btn:disabled {
                                        opacity: 0.55;
                                        cursor: not-allowed;
                                        transform: none;
                                    }

                                    /* =========================================
                                                                   NO PENDING RECRUITERS CARD
                                                                   ========================================= */

                                    .container-fluid > .card {
                                        border-radius: 16px;
                                        border: 1px solid #e5edf2 !important;
                                        box-shadow: 0 4px 14px rgba(24, 59, 86, 0.07) !important;
                                    }

                                        .container-fluid > .card .card-body {
                                            background: white;
                                            border-radius: 16px;
                                        }

                                        .container-fluid > .card .fs-1 {
                                            color: #2878ad !important;
                                        }

                                        .container-fluid > .card h5 {
                                            color: #183b56;
                                        }

                                    /* =========================================
                                                                   INFORMATION TEXT
                                                                   ========================================= */

                                    .small.text-muted {
                                        color: #71808c !important;
                                    }

                                    .small.text-success {
                                        color: #4b893e !important;
                                    }

                                    /* =========================================
                                                                   MOBILE
                                                                   ========================================= */

                                    @@media (max-width: 768px) {
                                        .container-fluid {
                                            padding: 15px !important;
                                        }

                                            .container-fluid > .d-flex:first-child {
                                                flex-direction: column;
                                                align-items: flex-start !important;
                                                gap: 15px;
                                            }

                                                .container-fluid > .d-flex:first-child .btn {
                                                    width: 100%;
                                                }

                                        .row.g-4 > .col-12 > .card .card-body {
                                            padding: 18px;
                                        }

                                        .card-body .btn {
                                            margin-bottom: 8px;
                                        }

                    </style>

                </div>
            }

        </div>
    }

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const tooltipTriggerList =
            document.querySelectorAll('[data-bs-toggle="tooltip"]');

        tooltipTriggerList.forEach(function (tooltipTriggerEl) {

            new bootstrap.Tooltip(tooltipTriggerEl);

        });

    });

</script>
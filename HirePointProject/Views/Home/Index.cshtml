@{
    ViewData["Title"] = "Welcome";
}

<div class="hirepoint-home">

    <div class="hirepoint-hero">

        <div class="hirepoint-icon">
            <i class="bi bi-mortarboard-fill"></i>
        </div>

        <h1>
            Welcome to <strong>HirePoint</strong>
        </h1>

        <p>
            Your Gateway to Career Opportunities
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn hirepoint-start-btn">

            <i class="bi bi-arrow-right-circle me-2"></i>

            Get Started

        </a>

    </div>

</div>


<style>

    body {
        margin: 0;
    }

    .hirepoint-home {
        min-height: 100vh;
        background: #2878ad;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }


    .hirepoint-hero {
        width: 100%;
        max-width: 700px;
        text-align: center;
        color: white;
    }


    .hirepoint-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 22px;
        font-size: 42px;
    }


    .hirepoint-hero h1 {
        font-size: 48px;
        font-weight: 400;
        margin-bottom: 20px;
    }


        .hirepoint-hero h1 strong {
            font-weight: 800;
        }


    .hirepoint-hero p {
        max-width: 600px;
        margin: 0 auto 35px;
        font-size: 18px;
        line-height: 1.7;
        color: rgba(255,255,255,0.9);
    }


    .hirepoint-start-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 30px;
        background: white;
        color: #2878ad;
        border: 2px solid white;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 700;
        transition: 0.2s ease;
    }


        .hirepoint-start-btn:hover {
            background: #f2f7fa;
            color: #1f628e;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }


    @@media (max-width: 600px) {

        .hirepoint-hero h1 {
            font-size: 34px;
        }

        .hirepoint-hero p {
            font-size: 16px;
        }

        .hirepoint-icon {
            width: 75px;
            height: 75px;
            font-size: 34px;
        }
    }

</style>

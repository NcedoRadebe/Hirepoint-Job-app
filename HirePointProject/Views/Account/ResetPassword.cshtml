@model HirePoint.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="mb-3">
                            <i class="bi bi-key"
                               style="font-size:45px; color:#2878ad;">
                            </i>
                        </div>

                        <h3 class="fw-bold">
                            Create New Password
                        </h3>

                        <p class="text-muted">
                            Enter your new password below.
                        </p>

                    </div>


                    <form asp-action="ResetPassword"
                          asp-controller="Account"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- RESET TOKEN -->

                        <input asp-for="Token"
                               type="hidden" />


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-lg"
                                   readonly />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- NEW PASSWORD -->

                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PASSWORD REQUIREMENTS -->

                        <div class="alert alert-info small mb-4">

                            <strong>Password requirements:</strong>

                            <ul class="mb-0 mt-2">
                                <li>Exactly 8 characters</li>
                                <li>At least 1 uppercase letter</li>
                                <li>At least 1 lowercase letter</li>
                                <li>At least 2 numbers</li>
                                <li>At least 1 special character</li>
                            </ul>

                        </div>


                        <!-- RESET BUTTON -->

                        <button type="submit"
                                class="btn w-100 btn-lg text-white"
                                style="background-color:#2878ad;">

                            <i class="bi bi-check-circle me-2"></i>

                            Reset Password

                        </button>

                    </form>


                    <div class="text-center mt-4">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-decoration-none">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back to Sign In

                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model HirePoint.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Create New Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="mb-3">
                            <i class="bi bi-lock"
                               style="font-size: 45px; color: #2878ad;">
                            </i>
                        </div>

                        <h3 class="fw-bold">
                            Create a New Password
                        </h3>

                        <p class="text-muted mb-0">
                            Choose a new password for your HirePoint
                            account.
                        </p>

                    </div>

                    <form asp-action="ChangePassword"
                          asp-controller="Account"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Email" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Account Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />

                        </div>


                        <!-- NEW PASSWORD -->

                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">

                                New Password

                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your new password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Use at least 8 characters.
                            </div>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">

                                Confirm New Password

                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Re-enter your new password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- BUTTON -->

                        <button type="submit"
                                class="btn w-100 btn-lg text-white"
                                style="background-color:#2878ad;">

                            <i class="bi bi-check-circle me-2"></i>
                            Update Password

                        </button>

                    </form>


                    <div class="text-center mt-4">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-decoration-none">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Sign In

                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
@model HirePoint.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="forgot-page">

    <div class="forgot-card">

        <div class="graduation-cap">

            <svg viewBox="0 0 120 100"
                 xmlns="http://www.w3.org/2000/svg">

                <polygon points="60,8 110,32 60,56 10,32"
                         fill="none"
                         stroke="#2878ad"
                         stroke-width="5"
                         stroke-linejoin="round" />

                <path d="M30 42
                L30 57
                C30 70 90 70 90 57
                L90 42"
                      fill="none"
                      stroke="#2878ad"
                      stroke-width="5"
                      stroke-linecap="round" />

                <line x1="60"
                      y1="56"
                      x2="60"
                      y2="70"
                      stroke="#2878ad"
                      stroke-width="5"
                      stroke-linecap="round" />

                <line x1="110"
                      y1="32"
                      x2="110"
                      y2="62"
                      stroke="#2878ad"
                      stroke-width="4"
                      stroke-linecap="round" />

                <path d="M103 62
                L117 62
                L114 78
                L106 78
                Z"
                      fill="#2878ad" />

            </svg>

        </div>

        <h1>HirePoint</h1>

        <p class="brand-text">
            Reset your password and get back to your career journey.
        </p>


        <div class="forgot-header">

            <h2>Forgot Password?</h2>

            <p>
                Enter your registered email and we'll send you
                a secure password reset link.
            </p>

        </div>


        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            @if (TempData["Success"] != null)
            {
                <div class="alert-success">
                    @TempData["Success"]
                </div>
            }


            @if (TempData["Error"] != null)
            {
                <div class="alert-error">
                    @TempData["Error"]
                </div>
            }


            <!-- EMAIL -->

            <div class="form-group">

                <label asp-for="Email">
                    Email Address
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter your registered email"
                       type="email"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <div class="password-info">

                <span class="info-circle">
                    i
                </span>

                <span>
                    A secure password reset link will be sent to your email.
                    The link expires after 30 minutes.
                </span>

            </div>


            <button type="submit"
                    class="btn-reset"
                    id="resetButton">
                Send Reset Link
                <span class="arrow">→</span>
            </button>


            <div class="back-login">

                <a asp-controller="Account"
                   asp-action="Login">

                    ← Back to Login

                </a>

            </div>

        </form>


        <div class="security-message">

            <span>🔒</span>

            <span>
                Your account information is secure.
            </span>

        </div>

    </div>

</div>


<style>

    .forgot-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 25px 15px;
        box-sizing: border-box;
        background-color: #2878ad;
    }

    .forgot-card {
        width: 410px;
        max-width: 100%;
        padding: 28px 38px;
        box-sizing: border-box;
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 18px 45px rgba(0,0,0,0.22);
        text-align: center;
    }

    .graduation-cap {
        width: 70px;
        height: 58px;
        margin: 0 auto 5px;
    }

        .graduation-cap svg {
            width: 70px;
            height: 58px;
        }

    .forgot-card h1 {
        margin: 0 0 3px;
        color: #2878ad;
        font-size: 27px;
        font-weight: 700;
    }

    .brand-text {
        margin: 0 auto 18px;
        max-width: 300px;
        color: #6b7280;
        font-size: 12px;
        line-height: 1.4;
    }

    .forgot-header {
        margin-bottom: 17px;
        text-align: left;
    }

        .forgot-header h2 {
            margin: 0 0 5px;
            color: #1f2937;
            font-size: 23px;
            font-weight: 700;
        }

        .forgot-header p {
            margin: 0;
            color: #6b7280;
            font-size: 12px;
            line-height: 1.5;
        }

    .form-group {
        margin-bottom: 14px;
        text-align: left;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
        }

    .form-control {
        width: 100%;
        height: 43px;
        padding: 0 13px;
        box-sizing: border-box;
        border: 1px solid #d7dde3;
        border-radius: 7px;
        background-color: #ffffff;
        color: #1f2937;
        font-size: 13px;
    }

        .form-control:focus {
            outline: none;
            border-color: #2878ad;
            box-shadow: 0 0 0 3px rgba(40,120,173,0.12);
        }

    .password-info {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-bottom: 15px;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.4;
        text-align: left;
    }

    .info-circle {
        width: 16px;
        height: 16px;
        min-width: 16px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #2878ad;
        color: white;
        font-size: 10px;
        font-weight: 700;
    }

    .btn-reset {
        width: 100%;
        height: 44px;
        border: none;
        border-radius: 7px;
        background-color: #2878ad;
        color: white;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-reset:hover {
            background-color: #21658f;
        }

    .arrow {
        margin-left: 7px;
        font-size: 17px;
    }

    .back-login {
        margin-top: 13px;
    }

        .back-login a {
            color: #2878ad;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }

            .back-login a:hover {
                text-decoration: underline;
            }

    .security-message {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin-top: 13px;
        color: #9ca3af;
        font-size: 10px;
    }

    .text-danger {
        display: block;
        margin-top: 4px;
        color: #dc3545;
        font-size: 11px;
    }

    .validation-summary {
        margin-bottom: 12px;
        color: #dc3545;
        font-size: 12px;
        text-align: left;
    }

    .alert-success {
        padding: 9px 11px;
        margin-bottom: 14px;
        border-radius: 7px;
        background-color: #ecfdf3;
        border: 1px solid #a7f3d0;
        color: #067647;
        font-size: 11px;
        text-align: left;
    }

    .alert-error {
        padding: 9px 11px;
        margin-bottom: 14px;
        border-radius: 7px;
        background-color: #fff1f2;
        border: 1px solid #fecdd3;
        color: #b42318;
        font-size: 11px;
        text-align: left;
    }

    @@media (max-width: 500px) {

        .forgot-card {
            width: 100%;
            padding: 25px;
        }
    }

</style>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}
<script>
    document.addEventListener("DOMContentLoaded", function() {

        const form = document.querySelector("form");
        const button = document.getElementById("resetButton");

        if (form && button) {

            form.addEventListener("submit", function() {

                button.disabled = true;
                button.innerHTML = "Sending...";

            });

        }

    });
</script>
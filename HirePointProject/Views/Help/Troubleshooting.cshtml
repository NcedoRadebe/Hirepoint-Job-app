@{
    ViewData["Title"] = "Troubleshooting";
}

<div class="help-page">

    <div class="help-page-header">

        <div>
            <span class="help-eyebrow">
                <i class="bi bi-tools"></i>
                HELP CENTRE
            </span>

            <h1>Troubleshooting</h1>

            <p>
                Common problems and ways to resolve them.
            </p>
        </div>

        <div class="help-header-icon">
            <i class="bi bi-wrench-adjustable"></i>
        </div>

    </div>


    <div class="troubleshooting-list">

        <div class="troubleshooting-card">

            <div class="trouble-number">
                01
            </div>

            <div>
                <h3>
                    A required field is highlighted
                </h3>

                <p>
                    Check that all required information has
                    been entered. Required fields must be
                    completed before the form can be submitted.
                </p>
            </div>

        </div>


        <div class="troubleshooting-card">

            <div class="trouble-number">
                02
            </div>

            <div>
                <h3>
                    No search results are displayed
                </h3>

                <p>
                    Try changing your search keywords or
                    filters. Make sure the search criteria
                    are not too restrictive.
                </p>
            </div>

        </div>


        <div class="troubleshooting-card">

            <div class="trouble-number">
                03
            </div>

            <div>
                <h3>
                    A record cannot be found
                </h3>

                <p>
                    The record may have been removed, may not
                    be available to your account type, or your
                    search criteria may need to be changed.
                </p>
            </div>

        </div>


        <div class="troubleshooting-card">

            <div class="trouble-number">
                04
            </div>

            <div>
                <h3>
                    The page does not respond
                </h3>

                <p>
                    Check your internet connection and try
                    refreshing the page. If the problem continues,
                    return to the dashboard and try the action again.
                </p>
            </div>

        </div>


        <div class="troubleshooting-card">

            <div class="trouble-number">
                05
            </div>

            <div>
                <h3>
                    You are unsure what a field means
                </h3>

                <p>
                    Look for the
                    <strong>ⓘ</strong>
                    information icon beside the field.
                    Hover over it to view the tooltip.
                </p>
            </div>

        </div>

    </div>


    <div class="help-back-link">

        <a asp-controller="Help"
           asp-action="Index">

            <i class="bi bi-arrow-left"></i>
            Back to Help Centre

        </a>

    </div>

</div>

@model IEnumerable<HirePoint.Models.Job>

@{
    ViewData["Title"] = "Manage Jobs";

    var jobs = Model?.ToList() ?? new List<HirePoint.Models.Job>();

}

<style>

    .manage-jobs-page {
        background: #eef6fb;
        min-height: 100vh;
        padding: 35px 30px;
    }

    .manage-container {
        max-width: 1350px;
        margin: 0 auto;
    }

    .manage-header {
        margin-bottom: 28px;
    }

        .manage-header h2 {
            color: #183b56;
            font-weight: 700;
            margin-bottom: 7px;
            font-size: 28px;
        }

        .manage-header p {
            color: #66737d;
            margin: 0;
            font-size: 15px;
        }

    .jobs-card {
        background: #ffffff;
        border: 1px solid #d7e7f0;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(24, 59, 86, 0.08);
        overflow: hidden;
    }

    .jobs-card-header {
        background: #2878ad;
        color: #ffffff;
        padding: 21px 26px;
        display: flex;
        align-items: center;
    }

        .jobs-card-header h5 {
            margin: 0;
            font-size: 19px;
            font-weight: 600;
        }

    .jobs-card-body {
        padding: 28px;
    }

    .job-item {
        border: 1px solid #d7e7f0;
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 20px;
        background: #D7EBF7;
        transition: all 0.2s ease;
    }

        .job-item:hover {
            box-shadow: 0 7px 20px rgba(24, 59, 86, 0.10);
            border-color: #7CB7D9;
            transform: translateY(-1px);
        }

        .job-item:last-child {
            margin-bottom: 0;
        }

    .job-title {
        color: #183b56;
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 13px;
    }

    .job-info {
        color: #66737d;
        font-size: 14px;
        margin-bottom: 15px;
        line-height: 1.9;
    }

        .job-info span {
            margin-right: 22px;
            display: inline-block;
        }

    .job-description {
        color: #66737d;
        font-size: 14px;
        line-height: 1.7;
        margin-top: 12px;
        margin-bottom: 14px;
        max-width: 900px;
    }

    .closing-date {
        color: #66737d;
        font-size: 14px;
        margin-top: 10px;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: #e4f6eb;
        color: #247a45;
    }

    .status-closed {
        background: #fdeaea;
        color: #a33a3a;
    }

    .actions-area {
        border-left: 1px solid #e5eef3;
        padding-left: 25px;
        min-height: 150px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-end;
    }

    .edit-btn {
        background: #2878ad;
        color: #ffffff;
        text-decoration: none;
        border-radius: 8px;
        padding: 11px 18px;
        font-size: 14px;
        font-weight: 600;
        display: inline-block;
        min-width: 105px;
        text-align: center;
        transition: background 0.2s ease;
    }

        .edit-btn:hover {
            background: #183b56;
            color: #ffffff;
        }

    /* DELETE DISABLED */

    .delete-btn {
        background: #cfcfcf;
        color: #777777;
        border: 1px solid #bdbdbd;
        border-radius: 8px;
        padding: 11px 18px;
        font-size: 14px;
        font-weight: 600;
        cursor: not-allowed;
        opacity: 0.75;
        min-width: 105px;
        margin-top: 10px;
    }

        .delete-btn:disabled {
            background: #cfcfcf;
            color: #777777;
            border-color: #bdbdbd;
            cursor: not-allowed;
            opacity: 0.75;
        }

    .delete-info {
        color: #888888;
        font-size: 11px;
        margin-top: 6px;
        text-align: center;
    }

    .empty-jobs {
        text-align: center;
        padding: 75px 20px;
        color: #66737d;
    }

        .empty-jobs i {
            display: block;
            font-size: 52px;
            color: #9bbbd1;
            margin-bottom: 18px;
        }

        .empty-jobs h5 {
            color: #183b56;
            font-weight: 700;
            font-size: 20px;
            margin-bottom: 8px;
        }

        .empty-jobs p {
            margin: 0;
            font-size: 14px;
        }

    .alert {
        border-radius: 9px;
        margin-bottom: 22px;
    }

    @@media (max-width: 768px) {

        .manage-jobs-page {
            padding: 20px 15px;
        }

        .manage-header h2 {
            font-size: 24px;
        }

        .jobs-card-header {
            padding: 18px;
        }

        .jobs-card-body {
            padding: 15px;
        }

        .job-item {
            padding: 20px;
        }

        .job-title {
            font-size: 19px;
        }

        .job-info span {
            display: block;
            margin-right: 0;
            margin-bottom: 4px;
        }

        .actions-area {
            border-left: none;
            border-top: 1px solid #e5eef3;
            padding-left: 0;
            padding-top: 20px;
            margin-top: 20px;
            min-height: auto;
            align-items: stretch;
        }

        .edit-btn,
        .delete-btn {
            width: 100%;
            text-align: center;
        }

        .delete-info {
            text-align: center;
        }
    }

</style>

<div class="manage-jobs-page">

    <div class="manage-container">

        <!-- HEADER -->

        <div class="manage-header">

            <h2>
                <i class="bi bi-briefcase me-2"></i>
                Manage Jobs
            </h2>

            <p>
                View and manage your job listings.
            </p>

        </div>


        <!-- SUCCESS MESSAGE -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success"
                 data-bs-toggle="tooltip"
                 data-bs-placement="top"
                 title="This message confirms that your job management action was completed successfully.">

                <i class="bi bi-check-circle me-2"></i>

                @TempData["Success"]

            </div>
        }


        <!-- ERROR MESSAGE -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger"
                 data-bs-toggle="tooltip"
                 data-bs-placement="top"
                 title="This message explains an error that occurred while managing your jobs.">

                <i class="bi bi-exclamation-circle me-2"></i>

                @TempData["Error"]

            </div>
        }


        <!-- DATABASE ERROR -->
        @if (ViewBag.DbError != null)
        {
            <div class="alert alert-danger"
                 data-bs-toggle="tooltip"
                 data-bs-placement="top"
                 title="A database error occurred while loading or managing your job listings.">

                <strong>Database Error:</strong>

                @ViewBag.DbError

            </div>
        }


        <!-- JOBS CARD -->

        <div class="jobs-card">

            <div class="jobs-card-header">

                <h5>

                    <i class="bi bi-list-ul me-2"></i>

                    Your Job Listings

                </h5>

            </div>


            <div class="jobs-card-body">

                @if (jobs.Any())
                {
                    foreach (var job in jobs)
                    {
                        <div class="job-item">

                            <div class="row align-items-center">

                                <!-- JOB INFORMATION -->

                                <div class="col-lg-9 col-md-8">

                                    <div class="job-title"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="The title of this job listing.">

                                        @job.JobTitle

                                    </div>


                                    <div class="job-info">

                                        <!-- LOCATION -->

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The city and province where this job is located.">

                                            <i class="bi bi-geo-alt me-1"></i>

                                            @job.City, @job.Province
                                        </span>


                                        <!-- EMPLOYMENT TYPE -->

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The type of employment offered for this position.">

                                            <i class="bi bi-clock me-1"></i>

                                            @job.EmploymentType
                                        </span>


                                        <!-- EXPERIENCE -->

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The level of work experience required for this position.">

                                            <i class="bi bi-person-workspace me-1"></i>

                                            @job.ExperienceLevel
                                        </span>


                                        <!-- SALARY -->

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The salary or salary range offered for this position.">

                                            <i class="bi bi-cash me-1"></i>

                                            @job.Salary
                                        </span>


                                        <!-- DATE POSTED -->

                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="The date this job listing was posted.">

                                            <i class="bi bi-calendar me-1"></i>

                                            Posted:
                                            @job.DatePosted.ToString("dd MMM yyyy")
                                        </span>

                                    </div>


                                    <!-- DESCRIPTION -->
                                    @if (!string.IsNullOrWhiteSpace(job.JobDescription))
                                    {
                                        <div class="job-description"
                                             data-bs-toggle="tooltip"
                                             data-bs-placement="top"
                                             title="A summary of the responsibilities and duties for this job.">

                                            @{
                                                var description = job.JobDescription.Trim();

                                                if (description.Length > 250)
                                                {
                                                    description =
                                                        description.Substring(0, 250) + "...";
                                                }
                                            }

                                            @description

                                        </div>
                                    }


                                    <!-- CLOSING DATE -->

                                    <div class="closing-date"
                                         data-bs-toggle="tooltip"
                                         data-bs-placement="top"
                                         title="The date when applications for this job will close.">

                                        <i class="bi bi-calendar-x me-1"></i>

                                        Closing:
                                        @job.ClosingDate.ToString("dd MMM yyyy")

                                    </div>


                                    <!-- STATUS -->

                                    <div class="mt-3">

                                        @if (string.Equals(
                                            job.JobStatus?.Trim(),
                                            "Active",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="status-badge status-active"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="This job listing is currently active and available to jobseekers.">

                                                <i class="bi bi-check-circle me-1"></i>

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-closed"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top"
                                                  title="This job listing is not currently active.">

                                                <i class="bi bi-x-circle me-1"></i>

                                                @(string.IsNullOrWhiteSpace(job.JobStatus)
                                                    ? "Closed"
                                                    : job.JobStatus)

                                            </span>
                                        }

                                    </div>

                                </div>


                                <!-- ACTIONS -->

                                <div class="col-lg-3 col-md-4">

                                    <div class="actions-area">

                                        <!-- EDIT -->

                                        <a asp-controller="Recruiter"
                                           asp-action="EditJob"
                                           asp-route-id="@job.JobID"
                                           class="edit-btn"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="Edit the details of this job listing.">

                                            <i class="bi bi-pencil-square me-1"></i>

                                            Edit

                                        </a>


                                       

                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <!-- NO JOBS -->

                    <div class="empty-jobs">

                        <i class="bi bi-briefcase"></i>

                        <h5>
                            No Jobs Found
                        </h5>

                        <p>
                            You have not posted any jobs yet.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const tooltipTriggerList =
            document.querySelectorAll('[data-bs-toggle="tooltip"]');

        tooltipTriggerList.forEach(function (tooltipTriggerEl) {

            new bootstrap.Tooltip(tooltipTriggerEl);

        });

    });

</script>
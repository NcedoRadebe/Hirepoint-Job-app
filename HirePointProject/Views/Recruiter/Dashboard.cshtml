@{
    ViewData["Title"] = "Recruiter Dashboard";
}

<div class="dashboard-container">

    <!-- =========================================
     HEADER
     ========================================= -->

    <div class="dashboard-header">

        <div>
            <h2>
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
            </h2>

            <p class="mb-0">
                Welcome back
            </p>
        </div>

    </div>


    <!-- =========================================
     STATISTICS
     ========================================= -->

    <div class="row g-4 mb-4">

        <!-- TOTAL JOBS -->

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-card-body">

                    <div class="stat-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <div>

                        <h5>
                            Total Jobs
                        </h5>

                        <h2 class="stat-number">
                            @ViewBag.TotalJobs
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVE JOBS -->

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-card-body">

                    <div class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>

                        <h5>
                            Active Jobs
                        </h5>

                        <h2 class="stat-number">
                            @ViewBag.ActiveJobs
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- APPLICATIONS -->

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-card-body">

                    <div class="stat-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>

                        <h5>
                            Applications
                        </h5>

                        <h2 class="stat-number">
                            @ViewBag.TotalApplications
                        </h2>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
     MAIN CONTENT
     ========================================= -->

    <div class="row g-4">

        <!-- =====================================
         RECENT JOBS
         ===================================== -->

        <div class="col-lg-8">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>

                        <i class="bi bi-briefcase me-2"></i>

                        Recent Job Posts

                    </h5>

                </div>


                <div class="dashboard-card-body">

                    @if (ViewBag.RecentJobs != null &&
                         ViewBag.RecentJobs.Count > 0)
                    {
                        <div class="table-responsive">

                            <table class="table dashboard-table table-hover">

                                <thead>

                                    <tr>

                                        <th>
                                            Job Title
                                        </th>

                                        <th>
                                            Location
                                        </th>

                                        <th>
                                            Salary
                                        </th>

                                        <th>
                                            Employment
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var job in ViewBag.RecentJobs)
                                    {
                                        <tr>

                                            <td>

                                                <strong>
                                                    @job.JobTitle
                                                </strong>

                                            </td>


                                            <td>
                                                @job.City, @job.Province
                                            </td>


                                            <td>
                                                @job.Salary
                                            </td>


                                            <td>
                                                @job.EmploymentType
                                            </td>


                                            <td>

                                                @if (job.JobStatus == "Active")
                                                {
                                                    <span class="active-status">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="other-status">
                                                        @job.JobStatus
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="empty-dashboard-message">

                            <i class="bi bi-briefcase"></i>

                            <h5>
                                No Job Posts Yet
                            </h5>

                            <p class="mb-0">
                                Jobs that you publish will appear here.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- =====================================
         COMPANY PROFILE
         ===================================== -->

        <div class="col-lg-4">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>

                        <i class="bi bi-building me-2"></i>

                        Company Profile

                    </h5>

                </div>


                <div class="dashboard-card-body">

                    @if (ViewBag.Company != null)
                    {
                        <h4 class="company-name">
                            @ViewBag.Company.CompanyName
                        </h4>

                        <hr />

                        <div class="company-info">

                            <p>

                                <strong>
                                    Website
                                </strong>

                                <br />

                                @ViewBag.Company.Website

                            </p>


                            <p>

                                <strong>
                                    Description
                                </strong>

                                <br />

                                @ViewBag.Company.CompanyDescription

                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">

                            <i class="bi bi-exclamation-triangle me-2"></i>

                            Company profile not found.

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    /* =========================================
           DASHBOARD BACKGROUND
           ========================================= */

    .dashboard-container {
        min-height: 100vh;
        padding: 30px;
        background: #ffffff;
        border-radius: 20px;
    }


    /* =========================================
           HEADER
           ========================================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        box-shadow: 0 3px 12px rgba(245, 254, 255, 0.08);
    }

        .dashboard-header h2 {
            font-weight: 700;
            color: #172b4d;
            margin-bottom: 5px;
        }

        .dashboard-header p {
            color: #64748b;
        }


    /* =========================================
           STAT CARDS
           ========================================= */

    .stat-card {
        position: relative;
        overflow: hidden;
        min-height: 145px;
        border-radius: 12px;
        border: 1px solid #FBFFD9;
        background: #FBFFD9;
        color: #183b56;
        padding: 20px;
        height: 100%;
        box-shadow: 0 3px 10px rgba(24, 59, 86, 0.07);
        transition: all 0.2s ease;
    }
    

        .stat-card:hover {
            transform: translateY(-3px);
            border-color: #E4FF00;
            box-shadow: 0 6px 16px rgba(40, 120, 173, 0.16);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            right: -35px;
            bottom: -45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.10);
        }

    .stat-card-body {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 25px;
    }

    .stat-card h5 {
        margin: 0 0 8px;
        font-weight: 600;
        margin-bottom: 5px;
        color: rgba(24, 59, 86);
    }

    .stat-number {
        color: #2878ad;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef6fb;
        color: #333615;
        border-radius: 9px;
        font-size: 20px;
        margin-bottom: 12px;
    }


    /* =========================================
           DASHBOARD CARDS
           ========================================= */

    .dashboard-card {
        background: white;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        height: 100%;
    }

    .dashboard-card-header {
        padding: 18px 22px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

        .dashboard-card-header h5 {
            margin: 0;
            color: #172b4d;
            font-weight: 700;
        }

    .dashboard-card-body {
        padding: 22px;
    }


    /* =========================================
           TABLE
           ========================================= */

    .dashboard-table {
        margin-bottom: 0;
    }

        .dashboard-table thead th {
            background: #2878ad;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            border-bottom: 2px solid #e2e8f0;
            padding: 14px;
        }

        .dashboard-table tbody td {
            padding: 15px 14px;
            color: #334155;
        }


    /* =========================================
           STATUS
           ========================================= */

    .active-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #2878ad;
        color: white;
        font-size: 12px;
        font-weight: 600;
    }

    .other-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #64748b;
        color: white;
        font-size: 12px;
        font-weight: 600;
    }


    /* =========================================
           COMPANY
           ========================================= */

    .company-name {
        color: #172b4d;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .company-info p {
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .company-info strong {
        color: #334155;
    }


    /* =========================================
           EMPTY STATE
           ========================================= */

    .empty-dashboard-message {
        text-align: center;
        padding: 45px 20px;
        color: #64748b;
    }

        .empty-dashboard-message i {
            font-size: 42px;
            color: #2878ad;
            display: block;
            margin-bottom: 12px;
        }

        .empty-dashboard-message h5 {
            color: #172b4d;
            font-weight: 700;
            margin-bottom: 8px;
        }


    /* =========================================
           MOBILE
           ========================================= */

    @@media (max-width: 768px) {

        .dashboard-container {
            padding: 18px;
        }

        .dashboard-header {
            margin-bottom: 22px;
        }

        .stat-card {
            min-height: 125px;
        }
    }

</style>
<div class="mt-4 text-end">
    <button type="button"
            id="startRecruiterTour"
            class="btn btn-primary">
        <i class="bi bi-question-circle me-1"></i>
        Start Tour
    </button>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const startRecruiterTour =
                document.getElementById("startRecruiterTour");

            if (!startRecruiterTour) {
                return;
            }

            startRecruiterTour.addEventListener("click", function (event) {

                event.preventDefault();

                if (window.HirePointTour &&
                    typeof window.HirePointTour.startRecruiterFullTour === "function") {

                    window.HirePointTour.startRecruiterFullTour();

                } else {
                    console.error(
                        "HirePointTour.startRecruiterFullTour() is not available."
                    );
                }
            });
        });
    </script>
}
